local AutoBuy = {}

function AutoBuy.computeRJForGear(gear)
	local current_RJ = Inventory.get("RoyalJelly") or 0
	local total_craft_cost = 0
	for _, req in ipairs(gear.requirements) do
		local internalType, amount = req[1], req[2]
		if internalType == HONEY then
			-- skip
		elseif internalType == "RoyalJelly" then
			total_craft_cost = total_craft_cost + amount
		else
			local have = Inventory.get(internalType) or 0
			local shortfall = math.max(0, amount - have)
			if shortfall > 0 then
				total_craft_cost = total_craft_cost + rjCostFor(internalType, shortfall)
			end
		end
	end
	return math.max(0, total_craft_cost - current_RJ)
end

function AutoBuy.computeDiamondEggMissing()
	local dm = findGear("DiamondMask")
	if not dm or Ownership.owns(dm) then return 0 end
	local required = 5
	local current = Inventory.get("Diamond") or 0
	return math.max(0, required - current)
end

function AutoBuy.compute()
	local gearStates, perGear = {}, {}
	for _, gear in ipairs(GEARS) do
		local owned = Ownership.owns(gear)
		gearStates[gear.id] = owned
		perGear[gear.id] = {
			gear = gear,
			owned = owned,
			rjMissing = owned and 0 or AutoBuy.computeRJForGear(gear),
		}
	end
	return {
		perGear = perGear,
		gearStates = gearStates,
		diamondMissing = AutoBuy.computeDiamondEggMissing(),
	}
end


local function buildPlayerInfo()
	local page = makePage("PlayerInfo")
	local sec = makeSection(page, "PLAYER INFO", 220, 1)
	local list = new("Frame", {Size = UDim2.new(1,-16,0,190), Position = UDim2.fromOffset(8,24), BackgroundTransparency = 1}, sec)
	new("UIListLayout", {Padding = UDim.new(0,2)}, list)
	local function addRow(label, value, color)
		new("TextLabel", {Size = UDim2.new(1,0,0,14), BackgroundTransparency = 1,
			Text = string.format("%s: %s", label, value), TextColor3 = color or C.text,
			Font = FONT, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, list)
	end
	Pages.PlayerInfo = {frame = page, update = function()
		for _, ch in ipairs(list:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
		local stats = Cache and Cache:Get()
		if not stats then addRow("Stats", "Unavailable", C.muted); return end
		if StatTools then
			local ok, lifetime = pcall(function() return StatTools.GetTotal(stats, {"Honey"}) end)
			addRow("Lifetime Honey", ok and formatExact(lifetime) or "Unavailable", C.gold)
			local ok2, playtime = pcall(function() return StatTools.GetTotalPlaytime(stats, true) end)
			addRow("Playtime", ok2 and formatExact(math.floor(playtime)) .. "s" or "Unavailable")
			local ok3, bees = pcall(function() return StatTools.CountBees(stats) end)
			addRow("Bees", ok3 and formatExact(bees) or "Unavailable", C.green)
			local ok4, discovered = pcall(function() return StatTools.DiscoveredBeeCount(stats) end)
			addRow("Bee types", ok4 and formatExact(discovered) or "Unavailable")
			local ok5, badges = pcall(function() return StatTools.Count(stats, nil) end)
			addRow("Badges", ok5 and formatExact(badges) or "Unavailable")
			local gifted = getGiftedTypesDiscovered()
			addRow("Gifted types",
				gifted and string.format("%s / %d", formatExact(gifted), CONFIG.GIFTED_TYPES_TOTAL) or "Unavailable")
		else
			addRow("StatTools", "not loaded", C.gold)
		end
		addRow("Current Honey", getCurrentHoney() and formatExact(getCurrentHoney()) or "Unavailable", C.gold)
		local t = Inventory.get("Ticket")
		addRow("Tickets", t and formatExact(t) or "Unavailable")
	end}
end


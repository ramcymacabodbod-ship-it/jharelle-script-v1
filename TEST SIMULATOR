local RJAuto = { lastAttemptAt = 0, lastSeenCount = 0, failStreak = 0, pauseUntil = 0 }

function RJAuto.tick()
	local now = os.clock()
	if now < RJAuto.pauseUntil then return end

	if RJAuto.lastAttemptAt > 0 then
		if State.pending["Royal Jelly"] then return end
		local newCount = Inventory.get("RoyalJelly") or 0
		if newCount > RJAuto.lastSeenCount then
			RJAuto.failStreak = 0
			RJAuto.lastAttemptAt = 0
		else
			RJAuto.failStreak = RJAuto.failStreak + 1
			RJAuto.lastAttemptAt = 0
			if RJAuto.failStreak >= 2 then
				RJAuto.pauseUntil = now + 30
				RJAuto.failStreak = 0
				setStatus("RJ auto-buy paused: not confirming.", "error")
				return
			end
		end
	end

	local maxMissing, anyOn = 0, false
	for _, gear in ipairs(GEARS) do
		if State.autoBuyRJ[gear.id] and not Ownership.owns(gear) then
			anyOn = true
			local m = AutoBuy.computeRJForGear(gear)
			if m > maxMissing then maxMissing = m end
		end
	end
	if not anyOn or maxMissing <= 0 then return end

	local current = Inventory.get("RoyalJelly") or 0
	local chunk = math.min(maxMissing, CONFIG.MAX_AMOUNT)
	RJAuto.lastSeenCount = current
	RJAuto.lastAttemptAt = now

	local ok, msg = Network.purchase("Royal Jelly", "RoyalJelly", chunk)
	if ok then
		setStatus(string.format("RJ auto-buy: requesting %d", chunk), "info")
	else
		RJAuto.lastAttemptAt = 0
		RJAuto.failStreak = RJAuto.failStreak + 1
		if RJAuto.failStreak >= 3 then
			RJAuto.pauseUntil = now + 30
			RJAuto.failStreak = 0
		end
		if msg and not msg:find("cooldown") and not msg:find("pending") then
			setStatus("RJ auto-buy failed: " .. tostring(msg), "error")
		end
	end
end

local DiamondAuto = {
	lastAttemptAt = 0, lastSeenCount = 0, lastSeenTickets = 0,
	failStreak = 0, pauseUntil = 0,
}

function DiamondAuto.tick()
	if not State.autoBuyDiamondEgg then return end
	local now = os.clock()
	if now < DiamondAuto.pauseUntil then return end

	if DiamondAuto.lastAttemptAt > 0 then
		if State.pending["Diamond Egg"] then return end
		local newCount   = Inventory.get("Diamond") or 0
		local newTickets = Inventory.get("Ticket") or 0
		local gained  = newCount > DiamondAuto.lastSeenCount
		local spent   = newTickets < DiamondAuto.lastSeenTickets
		DiamondAuto.lastAttemptAt = 0
		if gained then
			DiamondAuto.failStreak = 0
		elseif spent then
			DiamondAuto.pauseUntil = now + 60
			setStatus("Diamond auto-buy paused: tickets spent, no egg.", "error")
			return
		else
			DiamondAuto.failStreak = DiamondAuto.failStreak + 1
			if DiamondAuto.failStreak >= 2 then
				DiamondAuto.pauseUntil = now + 30
				DiamondAuto.failStreak = 0
				setStatus("Diamond auto-buy paused: not confirming.", "error")
				return
			end
		end
	end

	local missing = AutoBuy.computeDiamondEggMissing()
	if missing <= 0 then return end

	local tickets = Inventory.get("Ticket") or 0
	if tickets < CONFIG.DIAMOND_EGG_TICKET_COST then
		setStatus(string.format("Diamond auto-buy: need %d tickets, have %d",
			CONFIG.DIAMOND_EGG_TICKET_COST, tickets), "warn")
		return
	end

	DiamondAuto.lastSeenCount   = Inventory.get("Diamond") or 0
	DiamondAuto.lastSeenTickets = tickets
	DiamondAuto.lastAttemptAt   = now

	local ok, msg = Network.purchase("Diamond Egg", "Diamond", 1)
	if ok then
		setStatus("Diamond auto-buy: requesting 1", "info")
	else
		DiamondAuto.lastAttemptAt = 0
		DiamondAuto.failStreak = DiamondAuto.failStreak + 1
		if DiamondAuto.failStreak >= 3 then
			DiamondAuto.pauseUntil = now + 30
			DiamondAuto.failStreak = 0
		end
		if msg and not msg:find("cooldown") and not msg:find("pending") then
			setStatus("Diamond auto-buy failed: " .. tostring(msg), "error")
		end
	end
end


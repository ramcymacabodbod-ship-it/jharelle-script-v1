local function formatExact(n)
	if type(n) ~= "number" then return "Unavailable" end
	local s = tostring(math.floor(n))
	local k
	repeat s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2") until k == 0
	return s
end

local function clampWindowPosition(x, y)
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local maxX = math.max(0, vp.X - CONFIG.WINDOW_SIZE.X.Offset)
	local maxY = math.max(0, vp.Y - CONFIG.WINDOW_SIZE.Y.Offset)
	return math.clamp(x, 0, maxX), math.clamp(y, 0, maxY)
end


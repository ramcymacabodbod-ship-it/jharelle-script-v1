local Network = {}

local function getItemPackageRemote()
	local events = ReplicatedStorage:FindFirstChild("Events")
	if not events then return nil end
	local remote = events:FindFirstChild("ItemPackageEvent")
	if remote and (remote:IsA("RemoteFunction") or remote:IsA("RemoteEvent")) then
		return remote
	end
	return nil
end

local function sendPurchase(typeId, amount)
	if not typeId then return false, "item identifier not verified" end
	if type(amount) ~= "number" or amount <= 0 then return false, "invalid amount" end
	amount = math.floor(amount)
	if amount > CONFIG.MAX_AMOUNT then return false, "amount exceeds MAX_AMOUNT" end
	local remote = getItemPackageRemote()
	if not remote then return false, "Events.ItemPackageEvent not found" end
	local payload = {Type = typeId, Category = "Eggs", Amount = amount}
	if remote:IsA("RemoteFunction") then
		local ok, ok2, err = pcall(function() return remote:InvokeServer("Purchase", payload) end)
		if not ok then return false, tostring(ok2) end
		return ok2 == true, ok2 == true and "confirmed" or tostring(err or ok2)
	else
		local ok, err = pcall(function() remote:FireServer("Purchase", payload) end)
		if not ok then return false, tostring(err) end
		return true, "sent"
	end
end

function Network.purchase(key, typeId, amount)
	local t = os.clock()
	local last = State.lastRequest[key] or -math.huge
	if t - last < CONFIG.REQUEST_COOLDOWN then
		return false, string.format("cooldown %.2fs", CONFIG.REQUEST_COOLDOWN - (t - last))
	end
	if State.pending[key] then return false, "request already pending" end
	State.lastRequest[key] = t
	State.pending[key] = {startedAt = t, requested = amount, preCount = Inventory.get(key)}
	local ok, msg = sendPurchase(typeId, amount)
	if not ok then State.pending[key] = nil end
	return ok, msg
end

local function resolvePending()
	local t = os.clock()
	for key, info in pairs(State.pending) do
		local current = Inventory.get(key)
		if current ~= nil and info.preCount ~= nil and current > info.preCount then
			State.pending[key] = nil
			setStatus(string.format("%s confirmed (+%d)", key, current - info.preCount), "good")
		elseif t - info.startedAt > 6 then
			State.pending[key] = nil
			setStatus(string.format("%s unconfirmed", key), "warn")
		end
	end
end


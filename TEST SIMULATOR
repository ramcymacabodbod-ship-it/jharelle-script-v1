-- 18. INITIALIZATION SEQUENCE & REFRESH LOOP
--=====================================================================
local function syncAllPagesToState()
	for _, p in pairs(Pages) do
		if p.update then pcall(p.update) end
	end
end

local function refreshAll()
	resolvePending()
	if Cache and Cache.Get then pcall(function() Cache:Update() end) end
	local page = Pages[State.currentPage]
	if page and page.update then
		local ok, err = pcall(page.update)
		if not ok then warn("[Test Simulator] refresh error: " .. tostring(err)) end
	end
end

task.spawn(function()
	-- 1. Start Loading
	setLoadingProgress("Initializing interface...", 0.1)

	-- 2. Load Player Data
	setLoadingProgress("Loading player data...", 0.2)
	if Cache then pcall(function() Cache:Update() end) end

	-- 3. Build Pages
	setLoadingProgress("Creating feature pages...", 0.3)
	local builders = {
		{name = "Dashboard", fn = buildDashboard, key = "Dashboard"},
		{name = "Royal Jelly", fn = buildRoyalJelly, key = "RoyalJelly"},
		{name = "Eggs", fn = buildEggs, key = "Eggs"},
		{name = "Blender", fn = buildBlender, key = "Blender"},
		{name = "Tickets", fn = buildTickets, key = "Tickets"},
		{name = "Player Info", fn = buildPlayerInfo, key = "PlayerInfo"},
		{name = "Inventory", fn = buildInventory, key = "Inventory"},
		{name = "Recipes", fn = buildRecipes, key = "RecipeCalc"},
		{name = "Quest", fn = buildQuest, key = "Quest"},
		{name = "Gear Reqs", fn = buildGearRequirements, key = "GearRequirements"},
		{name = "Auto Buy", fn = buildAutoBuy, key = "AutoBuy"},
	}

	local builtCount = 0
	for i, builder in ipairs(builders) do
		local ok, err = pcall(builder.fn)
		if ok then
			builtCount = builtCount + 1
		else
			warn("[Test Simulator] Failed to build " .. builder.name .. ": " .. tostring(err))
			pcall(buildErrorPage, builder.name, builder.key, err)
		end
		setLoadingProgress("Created " .. builder.name .. "...", 0.3 + (i / #builders) * 0.4)
	end

	-- 4. Connect Navigation
	setLoadingProgress("Connecting navigation...", 0.7)
	task.wait(0.1)

	-- 5. Restore Settings
	setLoadingProgress("Restoring saved settings...", 0.8)
	if loadedCfg then
		pcall(function() SaveSystem.applyWindowPos(loadedCfg) end)
	end
	syncAllPagesToState()

	-- 6. Loading Complete
	setLoadingProgress("Loading complete!", 1.0)
	task.wait(0.2)

	-- 7. Reveal
	loadingScreen.Visible = false
	showPage("Dashboard")
	uiReady = true

	-- Update Status Bar
	if builtCount < #builders then
		setStatus("Ready, but some pages failed to load. Check console.", "warn")
	elseif SaveSystem.isSupported() and not loadedCfg then
		setStatus("Ready. No saved settings — will save on change.", "info")
	elseif SaveSystem.isSupported() and loadedCfg then
		setStatus("Ready. Settings loaded.", "info")
	else
		setStatus("Ready (persistence unavailable).", "warn")
	end

	print("[Test Simulator] === STARTUP DIAGNOSTICS ===")
	print("  Pages built:", builtCount .. "/" .. #builders)
	print("  SaveSystem:", SaveSystem.isSupported() and "ready" or "unavailable")
	print("[Test Simulator] === END DIAGNOSTICS ===")

	-- Start Refresh Loop
	while State.running do
		pcall(refreshAll)
		pcall(RJAuto.tick)
		pcall(DiamondAuto.tick)
		pcall(tryAutoCondenser)
		pcall(tryQuestAuto)
		task.wait(CONFIG.REFRESH_INTERVAL)
	end
end)

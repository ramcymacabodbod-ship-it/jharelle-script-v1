	local function expandBase(internal, qty, out, depth)
		depth = depth or 0
		if qty <= 0 then return end
		if depth > 6 then out[internal] = (out[internal] or 0) + qty; return end
		local recipe = BlenderRecipes and BlenderRecipes.Get(internal)
		if not recipe then out[internal] = (out[internal] or 0) + qty; return end
		for _, ing in ipairs(recipe.Ingredients) do
			expandBase(ing.Type, ing.Amount * qty, out, depth + 1)
		end
	end

	local function rebuild()
		local internal = RECIPE_TYPES[State.recipeIndex]
		nameLbl.Text = Recipe.display(internal)
		qtyLbl.Text = tostring(State.recipeQty)
		for _, ch in ipairs(outList:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
		for _, ch in ipairs(baseList:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
		local recipe = BlenderRecipes and BlenderRecipes.Get(internal)
		if not recipe then
			new("TextLabel", {Size = UDim2.new(1,0,0,14), BackgroundTransparency = 1,
				Text = "Recipe data unavailable.", TextColor3 = C.gold, Font = FONT, TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Left}, outList)
			return
		end
		for _, ing in ipairs(recipe.Ingredients) do
			local need = ing.Amount * State.recipeQty
			local have = Inventory.get(ing.Type)
			local missing = have and math.max(0, need - have) or nil
			new("TextLabel", {Size = UDim2.new(1,0,0,14), BackgroundTransparency = 1,
				Text = string.format("%s — need %s (have %s, miss %s)", Recipe.display(ing.Type),
					formatExact(need), have and formatExact(have) or "?",
					missing and formatExact(missing) or "?"),
				TextColor3 = (missing and missing == 0) and C.green or C.text,
				Font = FONT, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd}, outList)
		end
		local base = {}
		expandBase(internal, State.recipeQty, base)
		local sorted = {}
		for k in pairs(base) do sorted[#sorted+1] = k end
		table.sort(sorted)
		for _, k in ipairs(sorted) do
			local need = base[k]
			local have = Inventory.get(k)
			local missing = have and math.max(0, need - have) or nil
			new("TextLabel", {Size = UDim2.new(1,0,0,14), BackgroundTransparency = 1,
				Text = string.format("%s — need %s (have %s, miss %s)", Recipe.display(k),
					formatExact(need), have and formatExact(have) or "?",
					missing and formatExact(missing) or "?"),
				TextColor3 = (missing and missing == 0) and C.green or C.text,
				Font = FONT, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd}, baseList)
		end
	end
	prev.MouseButton1Click:Connect(function()
		State.recipeIndex = ((State.recipeIndex - 2) % #RECIPE_TYPES) + 1; rebuild(); requestSave()
	end)
	next.MouseButton1Click:Connect(function()
		State.recipeIndex = (State.recipeIndex % #RECIPE_TYPES) + 1; rebuild(); requestSave()
	end)
	minus.MouseButton1Click:Connect(function()
		State.recipeQty = math.max(1, State.recipeQty - 1); rebuild(); requestSave()
	end)
	plus.MouseButton1Click:Connect(function()
		State.recipeQty = State.recipeQty + 1; rebuild(); requestSave()
	end)
	rebuild()
	Pages.RecipeCalc = {frame = page, update = function() rebuild() end}
end


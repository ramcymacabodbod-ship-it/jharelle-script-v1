local function applyScale()
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local neededW = CONFIG.WINDOW_POSITION.X.Offset + CONFIG.WINDOW_SIZE.X.Offset
	local neededH = CONFIG.WINDOW_POSITION.Y.Offset + CONFIG.WINDOW_SIZE.Y.Offset
	local s = math.min(1, math.min(vp.X / neededW, vp.Y / neededH))
	uiScale.Scale = math.max(0.6, s)
end
applyScale()
if Workspace.CurrentCamera then
	State.connections[#State.connections+1] = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
end


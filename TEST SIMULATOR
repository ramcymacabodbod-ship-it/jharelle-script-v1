local SaveSystem = {}
local SAVE_VERSION = 1
local SAVE_FOLDER = "TestSimulator"

local fsWrite, fsRead, fsIsFile, fsMakeFolder, fsIsFolder
pcall(function() fsWrite = writefile end)
pcall(function() fsRead  = readfile  end)
pcall(function() fsIsFile = isfile  end)
pcall(function() fsMakeFolder = makefolder end)
pcall(function() fsIsFolder = isfolder end)

function SaveSystem.isSupported()
	return type(fsWrite) == "function" and type(fsRead) == "function"
end

function SaveSystem.getPath()
	local username = LocalPlayer.Name
	if not username or username == "" then username = "UnknownUser" end
	local safeUsername = username:gsub("[^%w_%-]", "_")
	return SAVE_FOLDER .. "/" .. safeUsername .. ".json"
end

local function folderExists(path)
	if fsIsFolder then
		local ok, result = pcall(fsIsFolder, path)
		if ok then return result end
	end
	if fsIsFile then
		local ok, result = pcall(fsIsFile, path .. "/" .. LocalPlayer.Name .. ".json")
		if ok then return result end
	end
	return false
end

local function ensureFolder()
	if folderExists(SAVE_FOLDER) then return true end
	if fsMakeFolder then
		pcall(fsMakeFolder, SAVE_FOLDER)
		return folderExists(SAVE_FOLDER)
	end
	return false
end

local function validateAmount(value, allowed)
	if type(value) ~= "number" then return nil end
	for _, a in ipairs(allowed) do if a == value then return a end end
	return nil
end

function SaveSystem.load()
	if not SaveSystem.isSupported() then return nil end
	if not ensureFolder() then return nil end
	local path = SaveSystem.getPath()
	local okFile, exists = pcall(fsIsFile or function() return false end, path)
	if not okFile or not exists then return nil end
	local okRead, content = pcall(fsRead, path)
	if not okRead or type(content) ~= "string" or #content == 0 then return nil end
	local okDecode, data = pcall(function() return HttpService:JSONDecode(content) end)
	if not okDecode or type(data) ~= "table" then return nil end
	if data.version ~= SAVE_VERSION then return nil end
	return data
end

function SaveSystem.save()
	if not SaveSystem.isSupported() then return false end
	if not ensureFolder() then return false end
	local data = {
		version = SAVE_VERSION,
		savedAt = os.time(),
		autoBuyRJ = {
			DiamondMask  = State.autoBuyRJ.DiamondMask  == true,
			PetalBelt    = State.autoBuyRJ.PetalBelt    == true,
			CrimsonGuard = State.autoBuyRJ.CrimsonGuard == true,
			CobaltGuard  = State.autoBuyRJ.CobaltGuard  == true,
		},
		autoBuyDiamondEgg = State.autoBuyDiamondEgg == true,
		autoMagicBean = State.autoMagicBean == true,
		autoFieldDice = State.autoFieldDice == true,
		selectedRJ = State.selectedRJ,
		selectedTicket = State.selectedTicket,
		recipeIndex = State.recipeIndex,
		recipeQty = State.recipeQty,
		blenderQty = State.blenderQty,
		windowPos = {
			x = root and root.Position.X.Offset or 128,
			y = root and root.Position.Y.Offset or 139,
		},
	}
	local okEncode, encoded = pcall(function() return HttpService:JSONEncode(data) end)
	if not okEncode or type(encoded) ~= "string" then return false end
	local path = SaveSystem.getPath()
	local okWrite = pcall(fsWrite, path, encoded)
	return okWrite == true
end

function SaveSystem.applyToState(data)
	if type(data) ~= "table" then return end
	if type(data.autoBuyRJ) == "table" then
		for id in pairs(State.autoBuyRJ) do
			if type(data.autoBuyRJ[id]) == "boolean" then
				State.autoBuyRJ[id] = data.autoBuyRJ[id]
			end
		end
	end
	if type(data.autoBuyDiamondEgg) == "boolean" then
		State.autoBuyDiamondEgg = data.autoBuyDiamondEgg
	end
	if type(data.autoMagicBean) == "boolean" then
		State.autoMagicBean = data.autoMagicBean
	end
	if type(data.autoFieldDice) == "boolean" then
		State.autoFieldDice = data.autoFieldDice
	end
	local rjAmt = validateAmount(data.selectedRJ, CONFIG.ROYAL_JELLY_AMOUNTS)
	if rjAmt then State.selectedRJ = rjAmt end
	local tkAmt = validateAmount(data.selectedTicket, CONFIG.TICKET_AMOUNTS)
	if tkAmt then State.selectedTicket = tkAmt end
	if type(data.recipeIndex) == "number" and data.recipeIndex >= 1 and data.recipeIndex <= #RECIPE_TYPES then
		State.recipeIndex = data.recipeIndex
	end
	if type(data.recipeQty) == "number" and data.recipeQty >= 1 then State.recipeQty = data.recipeQty end
	if type(data.blenderQty) == "number" and data.blenderQty >= 1 then State.blenderQty = data.blenderQty end
end

function SaveSystem.applyWindowPos(data)
	if type(data) ~= "table" then return end
	if type(data.windowPos) ~= "table" or not root then return end
	local x = tonumber(data.windowPos.x)
	local y = tonumber(data.windowPos.y)
	if x and y and x == x and y == y then
		x, y = clampWindowPosition(x, y)
		root.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
	end
end

local saveDebounceToken = 0
local uiReady = false
local function requestSave()
	if not uiReady then return end
	saveDebounceToken = saveDebounceToken + 1
	local token = saveDebounceToken
	task.delay(0.5, function()
		if token ~= saveDebounceToken then return end
		SaveSystem.save()
	end)
end


local QuestAuto = {
	lastBeanAt = 0,
	lastDiceAt = 0,
	COOLDOWN = 2,
}

local function getSpiritBearQuestData()
	if not Quests or not Cache then return nil end
	local stats = Cache:Get()
	if not stats or not stats.Quests then return nil end

	local activeQuests = stats.Quests.Active or {}

	for i, name in ipairs(SPIRIT_BEAR_QUEST_NAMES) do
		local activeData = nil
		for _, a in ipairs(activeQuests) do
			if a.Name == name then
				activeData = a
				break
			end
		end

		if activeData then
			local questDef = Quests:Get(name)
			if questDef then
				local ok, tasks = pcall(function() return Quests.ResolveTasks(questDef, stats) end)
				if ok and tasks then
					local ok2, progress = pcall(function() return Quests:GetProgression(tasks, stats, activeData.StartValues, name) end)
					if ok2 and progress then
						return name, i, tasks, progress
					end
				end
			end
		else
			local ok, isComplete = pcall(function() return Quests:FlaggedComplete(name, stats) end)
			if ok and not isComplete then
				local questDef = Quests:Get(name)
				if questDef then
					local ok2, tasks = pcall(function() return Quests.ResolveTasks(questDef, stats) end)
					local progress = {}
					if ok2 and tasks then
						for j = 1, #tasks do
							progress[j] = {0, 0, tasks[j].Amount or 1}
						end
						return name, i, tasks, progress
					end
				end
			end
		end
	end

	local lastQuest = SPIRIT_BEAR_QUEST_NAMES[10]
	local questDef = Quests:Get(lastQuest)
	if questDef then
		local ok, tasks = pcall(function() return Quests.ResolveTasks(questDef, stats) end)
		local progress = {}
		if ok and tasks then
			for j = 1, #tasks do
				progress[j] = {1, tasks[j].Amount or 1, tasks[j].Amount or 1}
			end
			return lastQuest, 10, tasks, progress
		end
	end

	return nil
end

local function tryQuestAuto()
	if not State.autoMagicBean and not State.autoFieldDice then return end
	if not Quests or not Events or not Cache then return end

	local questName, qNum, tasks, progress = getSpiritBearQuestData()
	if not questName or not tasks or not progress then return end

	local t = os.clock()

	-- Auto Magic Bean (Quest 6)
	if State.autoMagicBean and qNum == 6 then
		local hasBean = Inventory.get("MagicBean") or 0
		local needsBean = false
		
		for i, task in ipairs(tasks) do
			local ok, desc = pcall(function() return Quests.GetTaskDescription(Cache:Get(), task) end)
			if ok and type(desc) == "string" and desc:find("Magic Bean") then
				local p = progress[i]
				if p and p[1] < 1 then needsBean = true end
				break
			end
		end

		if needsBean and hasBean > 0 and (t - QuestAuto.lastBeanAt) > QuestAuto.COOLDOWN then
			QuestAuto.lastBeanAt = t
			local ok = pcall(function()
				Events.ClientCall("PlayerActivesCommand", "Magic Bean")
			end)
			if ok then
				setStatus("Quest Auto: Used Magic Bean", "info")
			else
				setStatus("Quest Auto: Failed to use Magic Bean", "error")
			end
		end
	end

	-- Auto Field Dice (Quest 9)
	if State.autoFieldDice and qNum == 9 then
		local hasDice = Inventory.get("FieldDice") or 0
		local needsDice = false
		
		for i, task in ipairs(tasks) do
			local ok, desc = pcall(function() return Quests.GetTaskDescription(Cache:Get(), task) end)
			if ok and type(desc) == "string" and desc:Find("Field Dice") then
				local p = progress[i]
				if p and p[1] < 1 then needsDice = true end
				break
			end
		end

		if needsDice and hasDice > 0 and (t - QuestAuto.lastDiceAt) > QuestAuto.COOLDOWN then
			QuestAuto.lastDiceAt = t
			local ok = pcall(function()
				Events.ClientCall("PlayerActivesCommand", "Field Dice")
			end)
			if ok then
				setStatus("Quest Auto: Used Field Dice", "info")
			else
				setStatus("Quest Auto: Failed to use Field Dice", "error")
			end
		end
	end
end


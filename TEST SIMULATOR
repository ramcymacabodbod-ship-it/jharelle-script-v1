local Blender = {}

function Blender.getState()
	if not Cache then return nil end
	return Cache:Get("BlenderState")
end

function Blender.progress()
	local state = Blender.getState()
	if not state or not state.Recipe then return nil end
	local recipe = BlenderRecipes and BlenderRecipes.Get(state.Recipe)
	if not recipe then return nil end
	local nowP = nowPlaytime()
	if not nowP then return nil end
	local elapsed = nowP - (state.StartTime or nowP)
	local total = state.Count * recipe.Time
	local progress = math.clamp(elapsed / total, 0, 1)
	local remaining = math.max(0, total - elapsed)
	local acpt = recipe.AutoCompletePerTicket or 1
	local completed = math.floor(progress * state.Count)
	completed = math.floor(completed / acpt) * acpt
	local tickets = math.ceil((state.Count - completed) / acpt)
	return {
		recipe = state.Recipe, display = Recipe.display(state.Recipe),
		count = state.Count, remaining = remaining, progress = progress,
		completed = math.floor(progress * state.Count), tickets = math.max(0, tickets),
	}
end

function Blender.placeOrder(internalRecipe, count)
	if not Events then return false, "Events module not loaded" end
	local ok, res = pcall(function()
		return Events.ClientCall("BlenderCommand", "PlaceOrder", {Recipe = internalRecipe, Count = count})
	end)
	if not ok then return false, tostring(res) end
	if not res then return false, "rejected" end
	pcall(function() Cache:Set("BlenderState", res) end)
	return true, "order placed"
end

function Blender.stopOrder()
	if not Events then return false, "Events module not loaded" end
	local ok, err = pcall(function() Events.ClientCall("BlenderCommand", "StopOrder") end)
	if not ok then return false, tostring(err) end
	pcall(function() Cache:Set("BlenderState", nil) end)
	return true, "stopped"
end


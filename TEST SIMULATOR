	local speedBtn = makeButton(stSec, "Speed Up",     UDim2.fromOffset(80,22), C.panelAlt); speedBtn.Position = UDim2.fromOffset(104,68)

	local function refreshRecipe()
		local internal = RECIPE_TYPES[State.recipeIndex]
		nameLbl.Text = Recipe.display(internal)
		qtyLbl.Text = tostring(State.blenderQty)
		local recipe = BlenderRecipes and BlenderRecipes.Get(internal)
		for _, ch in ipairs(reqList:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
		if not recipe then reqLbl.Text = "Recipe data unavailable."; return end
		local reqs = {}
		for _, r in ipairs(recipe.Requirements or {}) do
			reqs[#reqs+1] = string.format("%s(%d)", tostring(r.Set or r.Type), r.Amount or 1)
		end
		reqLbl.Text = #reqs > 0 and ("Req: " .. table.concat(reqs, ", ")) or "No badge reqs."
		for _, ing in ipairs(recipe.Ingredients) do
			local have = Inventory.get(ing.Type)
			local need = ing.Amount * State.blenderQty
			new("TextLabel", {Size = UDim2.new(1,0,0,14), BackgroundTransparency = 1,
				Text = string.format("%s — %s (have %s)", Recipe.display(ing.Type),
					formatExact(need), have and formatExact(have) or "?"),
				TextColor3 = (have and have >= need) and C.green or C.text,
				Font = FONT, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, reqList)
		end
	end
	prev.MouseButton1Click:Connect(function()
		State.recipeIndex = ((State.recipeIndex - 2) % #RECIPE_TYPES) + 1; refreshRecipe(); requestSave()
	end)
	next.MouseButton1Click:Connect(function()
		State.recipeIndex = (State.recipeIndex % #RECIPE_TYPES) + 1; refreshRecipe(); requestSave()
	end)
	minus.MouseButton1Click:Connect(function()
		State.blenderQty = math.max(1, State.blenderQty - 1); refreshRecipe(); requestSave()
	end)
	plus.MouseButton1Click:Connect(function()
		State.blenderQty = math.min(CONFIG.MAX_BLENDER_COUNT, State.blenderQty + 1); refreshRecipe(); requestSave()
	end)
	place.MouseButton1Click:Connect(function()
		local internal = RECIPE_TYPES[State.recipeIndex]
		if not BlenderRecipes or not BlenderRecipes.Get(internal) then
			setStatus("BlenderRecipes not available.", "warn"); return
		end
		local ok, msg = Blender.placeOrder(internal, State.blenderQty)
		setStatus(ok and "Order placed." or ("Order failed: " .. tostring(msg)), ok and "good" or "error")
	end)
	endBtn.MouseButton1Click:Connect(function()
		local ok, msg = Blender.stopOrder()
		setStatus(ok and "Crafting stopped." or ("Stop failed: " .. tostring(msg)), ok and "good" or "error")
	end)
	speedBtn.MouseButton1Click:Connect(function()
		local ok, msg = Blender.speedUp()
		setStatus(ok and "Speed-up requested." or ("Speed-up failed: " .. tostring(msg)), ok and "good" or "error")
	end)
	refreshRecipe()
	Pages.Blender = {frame = page, update = function()
		local p = Blender.progress()
		if p then
			stLbl.Text = string.format("%s %d/%d • %ds left", p.display, p.completed, p.count, math.floor(p.remaining))
			stLbl.TextColor3 = C.gold
			costLbl.Text = string.format("Speed-up: %d Ticket%s", p.tickets, p.tickets == 1 and "" or "s")
			endBtn.BackgroundColor3 = C.red
			speedBtn.Visible = p.tickets > 0
		else
			stLbl.Text = "No active crafting."
			stLbl.TextColor3 = C.muted
			costLbl.Text = "Speed-up: —"
			endBtn.BackgroundColor3 = C.panelAlt
			speedBtn.Visible = false
		end
		refreshRecipe()
	end}
end


	State.running = false
	SaveSystem.save()
	for _, c in ipairs(State.connections) do pcall(function() c:Disconnect() end) end
	State.connections = {}
	if _G.__TEST_SIMULATOR_GUI then
		pcall(function() _G.__TEST_SIMULATOR_GUI:Destroy() end)
		_G.__TEST_SIMULATOR_GUI = nil
	end
end

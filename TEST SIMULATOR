local function nowPlaytime()
	local stats = Cache and Cache:Get()
	if not stats then return nil end
	local loadTime = stats.LoadTime
	local osNow = OsTime and OsTime() or os.time()
	if not loadTime then return nil end
	return (stats.PlaytimeAtLoad or 0) + (stats.OfflineProgressTime or 0) + (osNow - loadTime)
end


    end
end

-- Update Logic
local function updateInventory()
    local stats = ClientStatCache:Get()
    if not stats or type(stats.Eggs) ~= "table" then return end
    
    local inv = stats.Eggs
    local honey = (stats.Totals and stats.Totals.Honey) or stats.Honey or 0
    
    clearContent()
    
    if activeTab == "Inventory" then
        contentLayout.FillDirection = Enum.FillDirection.Horizontal
        contentLayout.Wraps = true
        for i, item in ipairs(TRACKED_ITEMS) do
            local card = Instance.new("Frame")
            card.Size = UDim2.new(0.5, -5, 0, 30)
            card.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            Instance.new("UICorner", card).CornerRadius = UDim.new(0, 4)
            card.LayoutOrder = i
            card.Parent = contentFrame
            
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -10, 0.5, 0)
            nameLbl.Position = UDim2.new(0, 5, 0, 2)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = item.Name
            nameLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
            nameLbl.Font = Enum.Font.Gotham
            nameLbl.TextSize = 10
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Parent = card
            
            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(1, -10, 0.5, 0)
            valLbl.Position = UDim2.new(0, 5, 0.5, -2)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = tostring(NumberCommas(inv[item.ID] or 0))
            valLbl.TextColor3 = Color3.new(1, 1, 1)
            valLbl.Font = Enum.Font.GothamBold
            valLbl.TextSize = 14
            valLbl.TextXAlignment = Enum.TextXAlignment.Left
            valLbl.Parent = card
        end
        contentFrame.CanvasSize = UDim2.new(0, 0, 0, math.ceil(#TRACKED_ITEMS / 2) * 35)
    else
        contentLayout.FillDirection = Enum.FillDirection.Vertical
        contentLayout.Wraps = false
        
        local targetRecipe
        for _, r in ipairs(RECIPES) do
            if r.Name == activeTab then targetRecipe = r break end
        end
        
        if targetRecipe then
            local reqsMet = 0
            for _, ing in ipairs(targetRecipe.Ingredients) do
                local currentQty = (ing.ID == "Honey") and honey or (inv[ing.ID] or 0)
                if currentQty >= ing.Required then reqsMet = reqsMet + 1 end
            end
            
            -- Header
            local header = Instance.new("TextLabel")
            header.Size = UDim2.new(1, 0, 0, 20)
            header.BackgroundTransparency = 1
            header.Text = string.format("%s — %d/%d Requirements Complete", string.upper(targetRecipe.Name), reqsMet, #targetRecipe.Ingredients)
            header.TextColor3 = Color3.fromRGB(254, 200, 9)
            header.Font = Enum.Font.GothamBold
            header.TextSize = 12
            header.LayoutOrder = 1
            header.Parent = contentFrame
            
            -- Track available inventory cumulatively so shared materials (like Royal Jelly) aren't double-counted
            local remainingInv = {}
            for k, v in pairs(inv) do remainingInv[k] = v end

            local totalCanvasHeight = 25
            for i, ing in ipairs(targetRecipe.Ingredients) do
                local currentQty = (ing.ID == "Honey") and honey or (inv[ing.ID] or 0)
                local missingQty = math.max(ing.Required - currentQty, 0)
                local isComplete = currentQty >= ing.Required
                local craftRecipe = CRAFTING_RECIPES[ing.ID]
                
                local cardHeight = 50
                if missingQty > 0 and craftRecipe then
                    cardHeight = 50 + 20 + (#craftRecipe * 45)
                end
                
                -- Read-only Frame
                local card = Instance.new("Frame")
                card.Size = UDim2.new(1, -5, 0, cardHeight)
                card.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 4)
                card.LayoutOrder = i + 1
                card.Parent = contentFrame
                
                totalCanvasHeight = totalCanvasHeight + cardHeight + 5
                
                local titleLbl = Instance.new("TextLabel")
                titleLbl.Size = UDim2.new(1, -10, 0, 15)
                titleLbl.Position = UDim2.new(0, 5, 0, 5)
                titleLbl.BackgroundTransparency = 1
                titleLbl.Text = ing.Name
                titleLbl.TextColor3 = Color3.new(1, 1, 1)
                titleLbl.Font = Enum.Font.GothamBold
                titleLbl.TextSize = 12
                titleLbl.TextXAlignment = Enum.TextXAlignment.Left
                titleLbl.Parent = card
                
                local progLbl = Instance.new("TextLabel")
                progLbl.Size = UDim2.new(1, -10, 0, 15)
                progLbl.Position = UDim2.new(0, 5, 0, 20)
                progLbl.BackgroundTransparency = 1
                progLbl.Text = string.format("%s / %s", NumberCommas(currentQty), NumberCommas(ing.Required))
                progLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
                progLbl.Font = Enum.Font.Gotham
                progLbl.TextSize = 11
                progLbl.TextXAlignment = Enum.TextXAlignment.Left
                progLbl.Parent = card
                
                local statusLbl = Instance.new("TextLabel")
                statusLbl.Size = UDim2.new(1, -10, 0, 15)
                statusLbl.Position = UDim2.new(0, 5, 0, 35)
                statusLbl.BackgroundTransparency = 1
                statusLbl.Text = isComplete and "Complete" or string.format("Missing: %s", NumberCommas(missingQty))
                statusLbl.TextColor3 = isComplete and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
                statusLbl.Font = Enum.Font.GothamBold
                statusLbl.TextSize = 11
                statusLbl.TextXAlignment = Enum.TextXAlignment.Left
                statusLbl.Parent = card
                
                if missingQty > 0 and craftRecipe then
                    local craftHeader = Instance.new("TextLabel")
                    craftHeader.Size = UDim2.new(1, -10, 0, 15)
                    craftHeader.Position = UDim2.new(0, 5, 0, 50)
                    craftHeader.BackgroundTransparency = 1
                    craftHeader.Text = "Crafting materials:"
                    craftHeader.TextColor3 = Color3.fromRGB(200, 200, 255)
                    craftHeader.Font = Enum.Font.GothamSemibold
                    craftHeader.TextSize = 10
                    craftHeader.TextXAlignment = Enum.TextXAlignment.Left
                    craftHeader.Parent = card
                    
                    local yOffset = 65
                    for _, mat in ipairs(craftRecipe) do
                        local matNeeded = missingQty * mat.Req
                        local matOwnedTotal = inv[mat.ID] or 0
                        
                        -- Allocate available inventory strictly once across the whole recipe
                        local allocated = math.min(matNeeded, remainingInv[mat.ID] or 0)
                        local matStillNeed = matNeeded - allocated
                        remainingInv[mat.ID] = (remainingInv[mat.ID] or 0) - allocated
                        
                        local matNameLbl = Instance.new("TextLabel")
                        matNameLbl.Size = UDim2.new(1, -15, 0, 15)
                        matNameLbl.Position = UDim2.new(0, 10, 0, yOffset)
                        matNameLbl.BackgroundTransparency = 1
                        matNameLbl.Text = string.format("%s — Required: %s", mat.Name, NumberCommas(matNeeded))
                        matNameLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
                        matNameLbl.Font = Enum.Font.Gotham
                        matNameLbl.TextSize = 10
                        matNameLbl.TextXAlignment = Enum.TextXAlignment.Left
                        matNameLbl.Parent = card
                        
                        local matOwnedLbl = Instance.new("TextLabel")
                        matOwnedLbl.Size = UDim2.new(1, -15, 0, 15)
                        matOwnedLbl.Position = UDim2.new(0, 10, 0, yOffset + 15)
                        matOwnedLbl.BackgroundTransparency = 1
                        matOwnedLbl.Text = string.format("Owned: %s", NumberCommas(matOwnedTotal))
                        matOwnedLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
                        matOwnedLbl.Font = Enum.Font.Gotham
                        matOwnedLbl.TextSize = 10
                        matOwnedLbl.TextXAlignment = Enum.TextXAlignment.Left
                        matOwnedLbl.Parent = card

                        local matNeedLbl = Instance.new("TextLabel")
                        matNeedLbl.Size = UDim2.new(1, -15, 0, 15)
                        matNeedLbl.Position = UDim2.new(0, 10, 0, yOffset + 30)
                        matNeedLbl.BackgroundTransparency = 1
                        matNeedLbl.Text = string.format("Still need: %s", NumberCommas(matStillNeed))
                        matNeedLbl.TextColor3 = (matStillNeed == 0) and Color3.fromRGB(150, 200, 150) or Color3.fromRGB(200, 150, 150)
                        matNeedLbl.Font = Enum.Font.GothamBold
                        matNeedLbl.TextSize = 10
                        matNeedLbl.TextXAlignment = Enum.TextXAlignment.Left
                        matNeedLbl.Parent = card
                        
                        yOffset = yOffset + 45
                    end
                end
            end
            contentFrame.CanvasSize = UDim2.new(0, 0, 0, totalCanvasHeight)
        end
    end
end

-- Live Polling
task.spawn(function()
    while task.wait(1) do
        pcall(updateInventory)
    end
end)
updateInventory()

-- Tab Switching Logic
local tabs = {}
local activeTab = "Inventory"

local function createTabBtn(name, order)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.2, 0, 1, 0)
    btn.BackgroundColor3 = (name == activeTab) and Color3.fromRGB(40, 40, 50) or Color3.fromRGB(25, 25, 30)
    btn.BorderSizePixel = 0
    btn.Text = name == "Inventory" and "Inv" or name:gsub(" Guard", "G"):gsub(" Mask", "M"):gsub(" Belt", "B")
    btn.TextColor3 = (name == activeTab) and Color3.new(1,1,1) or Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 11
    btn.LayoutOrder = order
    btn.Parent = tabBar
    tabs[name] = btn
    
    btn.MouseButton1Click:Connect(function()
        activeTab = name
        for tName, tBtn in pairs(tabs) do
            tBtn.BackgroundColor3 = (tName == activeTab) and Color3.fromRGB(40, 40, 50) or Color3.fromRGB(25, 25, 30)
            tBtn.TextColor3 = (tName == activeTab) and Color3.new(1,1,1) or Color3.fromRGB(150, 150, 150)
        end
    end)
end

createTabBtn("Inventory", 1)
for i, rec in ipairs(RECIPES) do
    createTabBtn(rec.Name, i + 1)
end

-- Draggable Logic (Responsive & Bounded)
local dragging, dragInput, dragStart, startPos
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        local vp = workspace.CurrentCamera.ViewportSize
        local startX = (startPos.X.Scale * vp.X) + startPos.X.Offset
        local startY = (startPos.Y.Scale * vp.Y) + startPos.Y.Offset
        local newX = math.clamp(startX + delta.X, 0, vp.X - mainFrame.AbsoluteSize.X)
        local newY = math.clamp(startY + delta.Y, 0, vp.Y - mainFrame.AbsoluteSize.Y)
        mainFrame.Position = UDim2.new(0, newX, 0, newY)
    end
end)


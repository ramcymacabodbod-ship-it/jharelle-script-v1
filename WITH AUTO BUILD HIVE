}
local function showPage(key)
	if not Pages[key] then return end
	State.currentPage = key
	for name, p in pairs(Pages) do p.frame.Visible = (name == key) end
	for name, b in pairs(NavButtons) do
		b.BackgroundColor3 = (name == key) and C.blue or C.panelAlt
		b.TextColor3 = (name == key) and Color3.new(1,1,1) or C.text
	end
	local page = Pages[key]
	if page and page.update then
		local ok, err = pcall(page.update)
		if not ok then warn("[Test Simulator] page update error: "..tostring(err)) end
	end
end
for i, entry in ipairs(NAV_ORDER) do
	local btn = new("TextButton", {Size=UDim2.new(1,-4,0,18), BackgroundColor3=C.panelAlt,
		Text=entry.label, TextColor3=C.text, Font=FONT_MED, TextSize=10,
		TextXAlignment=Enum.TextXAlignment.Left, AutoButtonColor=false, BorderSizePixel=0,
		LayoutOrder=i}, navList)
	corner(btn, 5); new("UIPadding", {PaddingLeft=UDim.new(0,6)}, btn)
	NavButtons[entry.key] = btn
	btn.MouseButton1Click:Connect(function()
		if Pages[entry.key] then showPage(entry.key) end
		requestSave()
	end)
end


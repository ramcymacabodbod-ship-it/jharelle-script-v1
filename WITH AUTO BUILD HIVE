local function rjCostFor(internalType, qty, depth)
	depth = depth or 0
	if qty <= 0 or depth > 6 then return 0 end
	if internalType == "RoyalJelly" then return qty end
	local recipe = BlenderRecipes and BlenderRecipes.Get(internalType)
	if not recipe then return 0 end
	local total = 0
	for _, ing in ipairs(recipe.Ingredients) do total = total + rjCostFor(ing.Type, ing.Amount * qty, depth + 1) end
	return total
end

local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	if parent then inst.Parent = parent end
	return inst
end

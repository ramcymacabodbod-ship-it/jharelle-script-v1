-- 11.8 TOY AUTOMATION
--=====================================================================
local Toys = {
	["Glue Dispenser"]={name="Glue Dispenser",lastAttemptAt=0,lastFiredAt=0,pauseUntil=0,failStreak=0,
		lastState="unknown",lastDetail="Initializing",preFireTimes=nil,preFirePlaytimes=nil,SETTLE_SECS=10,MIN_RECHECK_SECS=3},
	["Wealth Clock"]={name="Wealth Clock",lastAttemptAt=0,lastFiredAt=0,pauseUntil=0,failStreak=0,
		lastState="unknown",lastDetail="Initializing",preFireTimes=nil,preFirePlaytimes=nil,SETTLE_SECS=10,MIN_RECHECK_SECS=3},
}
local toyModelCache = {}; local TOY_MODEL_TTL = 30
local function findToyModel(name)
	local toys = Workspace:FindFirstChild("Toys"); if not toys then return nil end
	local found = nil
	local function search(node)
		if found then return end
		if node:IsA("Model") and node.Name == name then found = node; return end
		if node:IsA("Folder") or node:IsA("Model") then
			for _, ch in ipairs(node:GetChildren()) do search(ch) end
		end
	end
	search(toys); return found
end
local function resolveToy(name)
	local now = os.clock(); local cached = toyModelCache[name]
	if cached and now - cached.resolvedAt < TOY_MODEL_TTL then return cached end
	local model = findToyModel(name); local entry = {model=model, resolvedAt=now}
	if model then
		entry.reqs = model:FindFirstChild("Requirements")
		entry.cooldown = model:FindFirstChild("Cooldown")
		entry.playtimeCooldown = model:FindFirstChild("PlaytimeCooldown")
	end
	toyModelCache[name] = entry; return entry
end
local function toyAvailability(name, stats)
	local info = resolveToy(name); if not info.model then return "unable", "Toy model not in Workspace.Toys" end
	if info.reqs then
		if not StatReqs then return "unable", "StatReqs module missing" end
		local okR, reqs = pcall(function() return require(info.reqs) end)
		if not okR then return "unable", "Requirements module error" end
		local okC, met = pcall(function() return StatReqs.Check(stats, reqs) end)
		if not okC then return "unable", "StatReqs.Check failed" end
		if not met then return "requirements", "Not eligible" end
	end
	if info.cooldown then
		local dur; pcall(function() dur = info.cooldown.Value end)
		if type(dur) == "number" and dur > 0 then
			local lastUse = (stats.ToyTimes and stats.ToyTimes[name]) or 0
			local osNow = math.floor((OsTime and OsTime() or os.time()))
			local elapsed = osNow - lastUse
			if elapsed < dur then return "cooldown", dur - elapsed end
		end
	end
	if info.playtimeCooldown then
		local dur; pcall(function() dur = info.playtimeCooldown.Value end)
		if type(dur) == "number" and dur > 0 then
			local lastPT = (stats.ToyPlaytimes and stats.ToyPlaytimes[name]) or 0
			if StatTools then
				local okP, curPT = pcall(function() return StatTools.GetTotalPlaytime(stats, true) end)
				if okP and type(curPT) == "number" then
					local elapsed = curPT - lastPT
					if elapsed < dur then return "playtime_cooldown", dur - elapsed end
				end
			end
		end
	end
	return "available", 0
end
local function fireToyRemote(name)
	local e = ReplicatedStorage:FindFirstChild("Events"); if not e then return false, "Events folder missing" end
	local r = e:FindFirstChild("ToyEvent"); if not r then return false, "ToyEvent remote missing" end
	if r:IsA("RemoteEvent") then
		local ok, err = pcall(function() r:FireServer(name) end)
		if not ok then return false, tostring(err) end; return true, "sent"
	else
		local ok, err = pcall(function() r:InvokeServer(name) end)
		if not ok then return false, tostring(err) end; return true, "invoked"
	end
end
local function formatRemaining(secs)
	if secs >= 3600 then return string.format("%.1fh remaining", secs/3600)
	elseif secs >= 60 then return string.format("%dm remaining", math.floor(secs/60))
	else return string.format("%ds remaining", math.floor(secs)) end
end
local function tickToys()
	local stats = Cache and Cache:Get(); if not stats then return end
	local t = os.clock()
	for name, st in pairs(Toys) do
		if not State.running then return end
		if _G.__TEST_SIMULATOR_INSTANCE ~= INSTANCE_ID then return end
		if st.lastFiredAt > 0 and (t - st.lastFiredAt) < st.SETTLE_SECS then
			st.lastState = "firing"; st.lastDetail = string.format("Confirming… %.0fs", st.SETTLE_SECS - (t - st.lastFiredAt))
			continue
		end
		if st.lastFiredAt > 0 then
			local nowT = (stats.ToyTimes and stats.ToyTimes[name]) or 0
			local nowP = (stats.ToyPlaytimes and stats.ToyPlaytimes[name]) or 0
			if (nowT ~= st.preFireTimes) or (nowP ~= st.preFirePlaytimes) then st.failStreak = 0
			else
				st.failStreak = (st.failStreak or 0) + 1
				if st.failStreak >= 1 then
					st.pauseUntil = t + 300; st.failStreak = 0
					setStatus(name..": fire not confirmed — pausing 5m.", "error")
				end
			end
			st.lastFiredAt = 0
		end
		if st.pauseUntil > 0 and t < st.pauseUntil then
			st.lastDetail = string.format("Paused (%.0fs)", st.pauseUntil - t); continue
		end
		if t - st.lastAttemptAt < st.MIN_RECHECK_SECS then continue end
		st.lastAttemptAt = t
		local kind, extra = toyAvailability(name, stats)
		if kind == "unable" then st.lastState="unable"; st.lastDetail=tostring(extra)
		elseif kind == "requirements" then st.lastState="requirements"; st.lastDetail="Badge/discovery requirement not met"
		elseif kind == "cooldown" or kind == "playtime_cooldown" then
			st.lastState = "cooldown"; st.lastDetail = formatRemaining(extra)
		elseif kind == "available" then
			st.lastState = "available"; st.lastDetail = "Ready"
			if toyAvailability(name, stats) ~= "available" then continue end
			st.preFireTimes = (stats.ToyTimes and stats.ToyTimes[name]) or 0
			st.preFirePlaytimes = (stats.ToyPlaytimes and stats.ToyPlaytimes[name]) or 0
			local ok, msg = fireToyRemote(name); st.lastFiredAt = t
			if ok then st.lastState="firing"; st.lastDetail="Sent, awaiting confirmation"
			else st.lastState="error"; st.lastDetail=tostring(msg) end
		end
	end
end


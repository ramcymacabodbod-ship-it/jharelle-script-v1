		BackgroundTransparency=1, Text="Protected slots: —", TextColor3=C.muted, Font=FONT,
		TextSize=10, TextXAlignment=Enum.TextXAlignment.Left}, statsSec)

	local ctrlSec = makeSection(page, "CONTROLS", 106, 5)
	local startBtn = makeButton(ctrlSec, "Start Build", UDim2.fromOffset(160,28), C.blue, Color3.new(1,1,1))
	startBtn.Position = UDim2.fromOffset(8, 24)
	new("TextLabel", {Size=UDim2.new(1,-16,0,44), Position=UDim2.fromOffset(8,58),
		BackgroundTransparency=1, Text="Royal Jelly produces a random Legendary — success is not guaranteed. Stage 1 obtains the six priority bees (Until Legendary OFF). Stage 2 completes the Legendary targets (Until Legendary ON). Excess target Legendaries are cleaned up automatically. Bee protection rules apply. Click Start Build again to stop.",
		TextColor3=C.muted, Font=FONT, TextSize=8, TextWrapped=true,
		TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top}, ctrlSec)
	startBtn.MouseButton1Click:Connect(function()
		BuildHive.running = not BuildHive.running
		if BuildHive.running then
			BuildHive.status = "Scanning Hive"
			BuildHive.failStreak = 0
			BuildHive.pauseUntil = 0
			BuildHive.pendingSlot = nil
			BuildHive.pendingTargetBee = nil
			BuildHive.slotCooldowns = {}
			BuildHive.lastConfirmedAt = 0
			StageControl.currentStage = nil
			StageControl.stageEnteredAt = 0
			StageControl.lastRetryAt = 0
			setStatus("Build Hive started", "info")
			print("[BuildHive] START")
		else
			BuildHive.pendingSlot = nil
			BuildHive.pendingTargetBee = nil
			BuildHive.status = "Stopped"
			setStatus("Build Hive stopped", "warn")
			print("[BuildHive] STOP")
		end
		startBtn.BackgroundColor3 = BuildHive.running and C.green or C.blue
	end)

	local jellySec = makeSection(page, "AUTO JELLY SETTINGS", 0, 6)
	jellySec.AutomaticSize = Enum.AutomaticSize.Y
	new("UIPadding", {PaddingBottom=UDim.new(0,8)}, jellySec)
	local jellyButtons, jellyStatusLbls = {}, {}
	local visibleKeys = {"RollToMythic", "RollToGifted"}
	for i, key in ipairs(visibleKeys) do
		local row = new("Frame", {Size=UDim2.new(1,-16,0,26),
			Position=UDim2.fromOffset(8, 24 + (i-1)*30), BackgroundTransparency=1}, jellySec)
		new("TextLabel", {Size=UDim2.new(0,140,1,0), BackgroundTransparency=1,
			Text=JellySettings.labels[key], TextColor3=C.text, Font=FONT_MED, TextSize=10,
			TextXAlignment=Enum.TextXAlignment.Left}, row)
		local btn = makeButton(row, "OFF", UDim2.fromOffset(70,22), C.panelAlt)
		btn.Position = UDim2.new(1, -170, 0, 2)
		local statusLbl2 = new("TextLabel", {Size=UDim2.new(0,90,1,0), Position=UDim2.new(1,-90,0,0),
			BackgroundTransparency=1, Text="Unknown", TextColor3=C.muted, Font=FONT,
			TextSize=9, TextXAlignment=Enum.TextXAlignment.Left}, row)
		jellyButtons[key] = btn; jellyStatusLbls[key] = statusLbl2
		btn.MouseButton1Click:Connect(function()
			local _, currentVal = JellySettings.getDisplay(key)
			local newVal = (currentVal == true) and false or true
			local ok, msg = JellySettings.setValue(key, newVal)
			if ok then
				setStatus("Setting "..JellySettings.labels[key].." → "..(newVal and "ON" or "OFF"), "info")
			else
				setStatus("Setting "..JellySettings.labels[key].." failed: "..tostring(msg), "error")
			end
		end)
	end
	new("TextLabel", {Size=UDim2.new(1,-16,0,20), Position=UDim2.fromOffset(8, 24 + #visibleKeys*30),
		BackgroundTransparency=1, Text="Until Legendary is auto-managed by the Build Hive stage (Stage 1: OFF, Stage 2: ON, Cleanup: OFF).",
		TextColor3=C.muted, Font=FONT, TextSize=8, TextWrapped=true,
		TextXAlignment=Enum.TextXAlignment.Left}, jellySec)

	Pages.BuildHive = {frame=page, update=function()
		local cells = scanHive()
		if cells then
			local state, priorityCounts, stage = computeAll(cells)
			local emptyCount = countEmpty(cells)
			local now = os.clock()
			local eligCount, protCount = 0, 0
			for key, cell in pairs(cells) do
				if cell.beeType then
					local ready = (not BuildHive.slotCooldowns[key]) or now >= BuildHive.slotCooldowns[key]
					local kind = classifyBee(cell.beeType, state, priorityCounts)
					if isEligibleKind(kind) then
						if ready then eligCount = eligCount + 1 end
					elseif kind ~= "priority_protected" and kind ~= "target_at_or_below" then
						protCount = protCount + 1
					end
				end
			end

			for _, beeName in ipairs(BuildHive.priorityOrder) do
				local have = priorityCounts[beeName] or 0
				local need = BuildHive.priority[beeName]
				local lbl = prioLabels[beeName]
				if have >= need then
					lbl.Text = string.format("%d/%d — Complete", have, need)
					lbl.TextColor3 = C.green
				else
					lbl.Text = string.format("%d/%d — Missing %d", have, need, need - have)
					lbl.TextColor3 = C.gold
				end
			end

			for _, beeName in ipairs(BuildHive.targetOrder) do
				local s = state[beeName]
				local lbl = compLabels[beeName]
				local text, color
				if s.category == "complete" then
					text = string.format("%d/%d — Complete", s.current, s.target); color = C.green
				elseif s.category == "missing" then
					text = string.format("%d/%d — Missing %d", s.current, s.target, s.delta); color = C.gold
				else
					text = string.format("%d/%d — Excess %d", s.current, s.target, s.delta); color = C.red
				end
				lbl.Text = text; lbl.TextColor3 = color
			end

			emptyLbl.Text = string.format("Empty slots: %d", emptyCount)
			emptyLbl.TextColor3 = emptyCount > 0 and C.gold or C.muted
			eligibleLbl.Text = string.format("Eligible slots: %d", eligCount)
			eligibleLbl.TextColor3 = eligCount > 0 and C.text or C.muted
			protectedLbl.Text = string.format("Protected slots: %d", protCount)
			protectedLbl.TextColor3 = C.muted

			local phaseText, phaseColor
			if stage == "priority" then
				phaseText, phaseColor = "Phase: Stage 1 — obtaining priority bees", C.blue
			elseif stage == "building" then
				phaseText, phaseColor = "Phase: Stage 2 — building Legendary targets", C.purple
			elseif stage == "cleanup" then
				phaseText, phaseColor = "Phase: Stage 2 — cleanup (targets met)", C.gold
			else
				phaseText, phaseColor = "Phase: Complete — all targets exact", C.green
			end
			phaseLbl.Text = phaseText
			phaseLbl.TextColor3 = phaseColor

			local disp, val, verifying = JellySettings.getDisplay("RollToLegendary")
			local autoText, autoColor
			if verifying then
				autoText, autoColor = "Until Legendary: "..disp.." (verifying…)", C.gold
			elseif val == true then
				autoText, autoColor = "Until Legendary: ON (auto)", C.green
			elseif val == false then
				autoText, autoColor = "Until Legendary: OFF (auto)", C.muted
			else
				autoText, autoColor = "Until Legendary: "..disp.." (auto)", C.muted
			end
			ulLegendaryLbl.Text = autoText
			ulLegendaryLbl.TextColor3 = autoColor

			if BuildHive.running then
				statusLbl.Text = BuildHive.status or "Idle"
				statusLbl.TextColor3 = C.gold
			elseif stage == "complete" then
				statusLbl.Text = "Build Complete"
				statusLbl.TextColor3 = C.green
			else
				statusLbl.Text = "Idle — press Start Build to begin."
				statusLbl.TextColor3 = C.muted
			end

			startBtn.BackgroundColor3 = BuildHive.running and C.green or C.blue
		end

		for _, key in ipairs(visibleKeys) do
			local disp, val, verifying = JellySettings.getDisplay(key)
			local btn = jellyButtons[key]
			btn.Text = disp
			if verifying then btn.BackgroundColor3 = C.panelAlt; btn.TextColor3 = C.gold
			elseif val == true then btn.BackgroundColor3 = C.green; btn.TextColor3 = Color3.new(1,1,1)
			elseif val == false then btn.BackgroundColor3 = C.panelAlt; btn.TextColor3 = C.text
			else btn.BackgroundColor3 = C.panelAlt; btn.TextColor3 = C.muted end
			local slbl = jellyStatusLbls[key]
			if verifying then slbl.Text = "Verifying…"; slbl.TextColor3 = C.gold
			elseif val ~= nil then slbl.Text = "Synced"; slbl.TextColor3 = C.muted
			else slbl.Text = "Unknown"; slbl.TextColor3 = C.muted end
		end
	end}
end


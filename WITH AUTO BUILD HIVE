local RJAuto = {lastAttemptAt=0, lastSeenCount=0, failStreak=0, pauseUntil=0}
function RJAuto.tick()
	local now = os.clock(); if now < RJAuto.pauseUntil then return end
	if RJAuto.lastAttemptAt > 0 then
		if State.pending["Royal Jelly"] then return end
		local nc = Inventory.get("RoyalJelly") or 0
		if nc > RJAuto.lastSeenCount then RJAuto.failStreak = 0; RJAuto.lastAttemptAt = 0
		else
			RJAuto.failStreak = RJAuto.failStreak + 1; RJAuto.lastAttemptAt = 0
			if RJAuto.failStreak >= 2 then
				RJAuto.pauseUntil = now + 30; RJAuto.failStreak = 0
				setStatus("RJ auto-buy paused: not confirming.", "error"); return
			end
		end
	end
	local maxMissing, anyOn = 0, false
	for _, gear in ipairs(GEARS) do
		if State.autoBuyRJ[gear.id] and not Ownership.owns(gear) then
			anyOn = true; local m = AutoBuy.computeRJForGear(gear)
			if m > maxMissing then maxMissing = m end
		end
	end
	if not anyOn or maxMissing <= 0 then return end
	local cur = Inventory.get("RoyalJelly") or 0
	local chunk = math.min(maxMissing, CONFIG.MAX_AMOUNT)
	RJAuto.lastSeenCount = cur; RJAuto.lastAttemptAt = now
	local ok, msg = Network.purchase("Royal Jelly", "RoyalJelly", chunk)
	if ok then setStatus(string.format("RJ auto-buy: requesting %d", chunk), "info")
	else
		RJAuto.lastAttemptAt = 0; RJAuto.failStreak = RJAuto.failStreak + 1
		if RJAuto.failStreak >= 3 then RJAuto.pauseUntil = now + 30; RJAuto.failStreak = 0 end
		if msg and not msg:find("cooldown") and not msg:find("pending") then
			setStatus("RJ auto-buy failed: "..tostring(msg), "error")
		end
	end
end


		BackgroundTransparency=1, Text="Until Legendary: — (auto)", TextColor3=C.muted, Font=FONT,
		TextSize=9, TextXAlignment=Enum.TextXAlignment.Left}, statusSec)
	local statusLbl = new("TextLabel", {Size=UDim2.new(1,-16,0,0), Position=UDim2.fromOffset(8,56),
		BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.Y, Text="Idle",
		TextColor3=C.muted, Font=FONT, TextSize=10, TextWrapped=true,
		TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Top}, statusSec)

	local statsSec = makeSection(page, "HIVE STATISTICS", 78, 4)
	local emptyLbl = new("TextLabel", {Size=UDim2.new(1,-16,0,14), Position=UDim2.fromOffset(8,24),
		BackgroundTransparency=1, Text="Empty slots: —", TextColor3=C.muted, Font=FONT,
		TextSize=10, TextXAlignment=Enum.TextXAlignment.Left}, statsSec)
	local eligibleLbl = new("TextLabel", {Size=UDim2.new(1,-16,0,14), Position=UDim2.fromOffset(8,40),
		BackgroundTransparency=1, Text="Eligible slots: —", TextColor3=C.muted, Font=FONT,
		TextSize=10, TextXAlignment=Enum.TextXAlignment.Left}, statsSec)

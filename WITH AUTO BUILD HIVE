local Condenser = {lastFireAt=-math.huge,pendingUntil=0,lastFireNectar=0,lastFireVials=0,
	COOLDOWN=8,VERIFY_WINDOW=6,MIN_NECTAR_SECS=43200,MAX_VIALS=10}
local function getComfortingNectarRemainingSeconds()
	if BuffTile and type(BuffTile.GetBuffTile) == "function" then
		local ok, tile = pcall(function() return BuffTile.GetBuffTile("Comforting Nectar") end)
		if ok and type(tile) == "table" then
			local s, d = tile.TimerStart, tile.TimerDur
			if type(s) == "number" and type(d) == "number" then
				return math.max(0, s + d - ((OsTime and OsTime()) or os.time()))
			end
		end
	end
	if not Cache or not StatModifiers then return nil end
	local stats = Cache:Get(); if not stats then return nil end
	local ok, mods = pcall(function() return StatModifiers.GetModsBySource(stats, "Comforting Nectar") end)
	if not ok or type(mods) ~= "table" or #mods == 0 then return nil end
	local osNow = (OsTime and OsTime()) or os.time(); local best = 0
	for _, m in ipairs(mods) do
		if type(m) == "table" and type(m.Dur) == "number" and type(m.Start) == "number" then
			local r = m.Dur - (osNow - m.Start); if r > best then best = r end
		end
	end
	return best
end
local function fireCondenser()
	local e = ReplicatedStorage:FindFirstChild("Events"); if not e then return false, "Events folder missing" end
	local r = e:FindFirstChild("NectarCondenser"); if not r then return false, "NectarCondenser remote missing" end
	if r:IsA("RemoteFunction") then
		local ok, err = pcall(function() r:InvokeServer("Comforting") end)
		if not ok then return false, tostring(err) end; return true, "invoked"
	else
		local ok, err = pcall(function() r:FireServer("Comforting") end)
		if not ok then return false, tostring(err) end; return true, "fired"
	end
end
local function tryAutoCondenser()
	if not State.autoBuyRJ.DiamondMask then return end
	if not Cache or not StatModifiers then return end
	local t = os.clock()
	if Condenser.pendingUntil > 0 then
		if t < Condenser.pendingUntil then return end
		local nv = Inventory.get("ComfortingVial") or 0; local nn = getComfortingNectarRemainingSeconds() or 0
		local gained = nv - Condenser.lastFireVials; local spent = Condenser.lastFireNectar - nn
		if gained >= 1 then setStatus(string.format("Condenser: +%d vial", gained), "good")
		elseif spent >= Condenser.MIN_NECTAR_SECS - 60 then setStatus("Condenser consumed 12h nectar", "good")
		else setStatus("Condenser fired, no change seen", "warn") end
		Condenser.pendingUntil = 0
	end
	local dm = findGear("DiamondMask"); if not dm or Ownership.owns(dm) then return end
	local vials = Inventory.get("ComfortingVial") or 0
	if vials >= 1 or vials >= Condenser.MAX_VIALS then return end
	local nectar = getComfortingNectarRemainingSeconds()
	if not nectar or nectar < Condenser.MIN_NECTAR_SECS then return end
	if t - Condenser.lastFireAt < Condenser.COOLDOWN then return end
	Condenser.lastFireAt = t; Condenser.lastFireNectar = nectar
	Condenser.lastFireVials = vials; Condenser.pendingUntil = t + Condenser.VERIFY_WINDOW
	local ok, msg = fireCondenser()
	if not ok then Condenser.pendingUntil = 0; setStatus("Condenser fire error: "..tostring(msg), "error"); return end
	setStatus(string.format("Condenser fired (%.1fh nectar)", nectar/3600), "info")
end


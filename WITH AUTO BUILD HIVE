local function scanHive()
	local stats = Cache and Cache:Get(); if not stats or not stats.Honeycomb then return nil end
	local cells = {}
	for x = 1, 5 do
		local col = stats.Honeycomb["x"..x]
		for y = 1, 10 do
			local cell = col and col["y"..y]
			cells[x..","..y] = {x=x, y=y, beeType=cell and cell.Type or nil, file=cell}
		end
	end
	return cells
end

local function computePriorityCounts(cells)
	local counts = {}
	for _, name in ipairs(BuildHive.priorityOrder) do counts[name] = 0 end
	for _, cell in pairs(cells) do
		if cell.beeType and counts[cell.beeType] ~= nil then
			counts[cell.beeType] = counts[cell.beeType] + 1
		end
	end
	return counts
end

local function computeTargetState(cells)
	local counts = {}
	for _, name in ipairs(BuildHive.targetOrder) do counts[name] = 0 end
	for _, cell in pairs(cells) do
		if cell.beeType and counts[cell.beeType] ~= nil then
			counts[cell.beeType] = counts[cell.beeType] + 1
		end
	end
	local state = {}
	for _, name in ipairs(BuildHive.targetOrder) do
		local cur, target = counts[name] or 0, BuildHive.targets[name]
		local category, delta
		if cur == target then category, delta = "complete", 0
		elseif cur < target then category, delta = "missing", target - cur
		else category, delta = "excess", cur - target end
		state[name] = {current=cur, target=target, category=category, delta=delta}
	end
	return state
end

local function computeAll(cells)
	local priorityCounts = computePriorityCounts(cells)
	local state = computeTargetState(cells)
	local prioritiesMet = true
	for _, name in ipairs(BuildHive.priorityOrder) do
		if (priorityCounts[name] or 0) < BuildHive.priority[name] then
			prioritiesMet = false; break
		end
	end
	local stage
	if not prioritiesMet then stage = "priority"
	else
		local anyMissing, anyExcess = false, false
		for _, name in ipairs(BuildHive.targetOrder) do
			if state[name].category == "missing" then anyMissing = true end
			if state[name].category == "excess" then anyExcess = true end
		end
		if anyMissing then stage = "building"
		elseif anyExcess then stage = "cleanup"
		else stage = "complete" end
	end
	return state, priorityCounts, stage
end

local function countEmpty(cells)
	local n = 0
	for _, cell in pairs(cells) do if not cell.beeType then n = n + 1 end end
	return n
end

local function classifyBee(beeName, state, priorityCounts)
	if not beeName then return "empty" end
	local rarity = getBeeRarity(beeName)
	if rarity == "Event" then return "event_protected" end
	if rarity == "Mythic" then return "mythic_protected" end
	if BuildHive.priority[beeName] then
		local have = (priorityCounts and priorityCounts[beeName]) or 0
		local need = BuildHive.priority[beeName]
		if have <= need then return "priority_protected" end
		return "priority_excess"
	end
	if state and state[beeName] then
		local s = state[beeName]
		if s.category == "excess" then return "target_excess" end
		return "target_at_or_below"
	end
	if rarity == "Legendary" then return "other_legendary" end
	if rarity == "Common" or rarity == "Rare" or rarity == "Epic" then return "base" end
	return "unknown"
end

local function sortByXY(a, b)
	if a.cell.x ~= b.cell.x then return a.cell.x < b.cell.x end
	return a.cell.y < b.cell.y
end

local function isEligibleKind(kind)
	return kind == "target_excess" or kind == "other_legendary" or kind == "base" or kind == "priority_excess"
end

local function planNextAction(cells)
	local state, priorityCounts, stage = computeAll(cells)
	if stage == "complete" then
		return {action="done", stage=stage, state=state, priorityCounts=priorityCounts}
	end
	local now = os.clock()
	local function ready(key)
		local cd = BuildHive.slotCooldowns[key]; return not cd or now >= cd
	end

	for _, name in ipairs(BuildHive.targetOrder) do
		if state[name].category == "excess" then
			local slots = {}
			for key, cell in pairs(cells) do
				if cell.beeType == name then slots[#slots+1] = {key=key, cell=cell} end
			end
			table.sort(slots, sortByXY)
			for i = BuildHive.targets[name] + 1, #slots do
				if ready(slots[i].key) then
					local underTarget = nil
					for _, n in ipairs(BuildHive.targetOrder) do
						if state[n].category == "missing" then underTarget = n; break end
					end
					return {action="reroll_excess", slot=slots[i].cell, slotKey=slots[i].key,
						sourceBee=name, targetBee=underTarget, stage=stage,
						state=state, priorityCounts=priorityCounts}
				end
			end
		end
	end

	if stage == "cleanup" then
		local anyExcessOnCooldown = false
		for _, name in ipairs(BuildHive.targetOrder) do
			if state[name].category == "excess" then
				for key, cell in pairs(cells) do
					if cell.beeType == name and not ready(key) then anyExcessOnCooldown = true; break end
				end
				if anyExcessOnCooldown then break end
			end
		end
		if anyExcessOnCooldown then
			return {action="wait", stage=stage, state=state, priorityCounts=priorityCounts,
				reason="Waiting for excess slot cooldowns"}
		end
		return {action="no_eligible", stage=stage, state=state, priorityCounts=priorityCounts,
			reason="Cleanup: no ready excess slots"}
	end

	for _, name in ipairs(BuildHive.priorityOrder) do
		local have = priorityCounts[name] or 0
		local need = BuildHive.priority[name]
		if have > need then
			local slots = {}
			for key, cell in pairs(cells) do
				if cell.beeType == name then slots[#slots+1] = {key=key, cell=cell} end
			end
			table.sort(slots, sortByXY)
			for i = need + 1, #slots do
				if ready(slots[i].key) then
					return {action="reroll_priority_excess", slot=slots[i].cell,
						slotKey=slots[i].key, sourceBee=name, stage=stage,
						state=state, priorityCounts=priorityCounts}
				end
			end
		end
	end

	local otherLegendary = {}
	for key, cell in pairs(cells) do
		if cell.beeType and ready(key) then
			if classifyBee(cell.beeType, state, priorityCounts) == "other_legendary" then
				otherLegendary[#otherLegendary+1] = {key=key, cell=cell}
			end
		end
	end
	table.sort(otherLegendary, sortByXY)
	if #otherLegendary > 0 then
		local targetBee = nil
		for _, n in ipairs(BuildHive.targetOrder) do
			if state[n].category == "missing" then targetBee = n; break end
		end
		local s = otherLegendary[1]
		return {action="reroll_legendary", slot=s.cell, slotKey=s.key,
			sourceBee=s.cell.beeType, targetBee=targetBee, stage=stage,
			state=state, priorityCounts=priorityCounts}
	end

	local baseSlots = {}
	for key, cell in pairs(cells) do
		if cell.beeType and ready(key) then
			if classifyBee(cell.beeType, state, priorityCounts) == "base" then
				baseSlots[#baseSlots+1] = {key=key, cell=cell}
			end
		end
	end
	table.sort(baseSlots, sortByXY)
	if #baseSlots > 0 then
		local targetBee = nil
		for _, n in ipairs(BuildHive.targetOrder) do
			if state[n].category == "missing" then targetBee = n; break end
		end
		local s = baseSlots[1]
		return {action="reroll_base", slot=s.cell, slotKey=s.key,
			targetBee=targetBee, stage=stage, state=state, priorityCounts=priorityCounts}
	end

	local anyEligibleOnCooldown = false
	for key, cell in pairs(cells) do
		if cell.beeType then
			local kind = classifyBee(cell.beeType, state, priorityCounts)
			if isEligibleKind(kind) and not ready(key) then
				anyEligibleOnCooldown = true; break
			end
		end
	end
	if anyEligibleOnCooldown then
		return {action="wait", stage=stage, state=state, priorityCounts=priorityCounts,
			reason="Waiting for slot cooldowns"}
	end

	return {action="no_eligible", stage=stage, state=state, priorityCounts=priorityCounts,
		reason="No eligible slots remain"}
end

local function placeJelly(cell, jellyType)
	if not Events then return false, "Events module not loaded", false end
	local pcall_ok, amountLeft, success, newHoneycomb, discoveredBees, eggUses = pcall(function()
		return Events.ClientCall("ConstructHiveCellFromEgg", cell.x, cell.y, jellyType, 1, false)
	end)
	if not pcall_ok then return false, "remote error: "..tostring(amountLeft), false end
	if not success then return false, "remote rejected (success="..tostring(success)..")", false end
	local dataComplete = true
	pcall(function()
		if type(amountLeft) == "number" then Cache:Set({"Eggs", jellyType}, amountLeft) else dataComplete = false end
		if newHoneycomb then Cache:Set("Honeycomb", newHoneycomb) else dataComplete = false end
		if discoveredBees then Cache:Set("DiscoveredBees", discoveredBees) end
		if eggUses then Cache:Set({"Totals", "EggUses"}, eggUses) end
	end)
	return true, jellyType, dataComplete
end

function BuildHive.tick()
	if not BuildHive.running then return end
	if not Cache then BuildHive.status = "Cache unavailable"; return end
	if _G.__TEST_SIMULATOR_INSTANCE ~= INSTANCE_ID then return end
	local now = os.clock()

	if now < BuildHive.pauseUntil then
		BuildHive.status = string.format("Paused (%.0fs)", BuildHive.pauseUntil - now); return
	end

	if BuildHive.pendingSlot then
		local elapsed = now - BuildHive.pendingStartedAt
		if elapsed < BuildHive.PENDING_INITIAL_WAIT then
			BuildHive.status = "Verifying Replacement"
			return
		end
		local freshCells = scanHive(); if not freshCells then return end
		local key = BuildHive.pendingSlot.x..","..BuildHive.pendingSlot.y
		local newCell = freshCells[key]
		local changed = newCell and newCell.beeType ~= BuildHive.pendingSlot.beeType
		if changed then
			BuildHive.failStreak = 0
			BuildHive.pendingSlot = nil
			BuildHive.pendingTargetBee = nil
			BuildHive.lastConfirmedAt = now
			print("[BuildHive] verification: hive changed OK")
		elseif elapsed >= BuildHive.PENDING_MAX_WAIT then
			BuildHive.failStreak = BuildHive.failStreak + 1
			BuildHive.slotCooldowns[key] = now + BuildHive.SLOT_COOLDOWN
			BuildHive.pendingSlot = nil
			BuildHive.pendingTargetBee = nil
			print("[BuildHive] verification: timeout, slot cooled down")
			if BuildHive.failStreak >= BuildHive.FAIL_THRESHOLD then
				BuildHive.pauseUntil = now + BuildHive.FAIL_PAUSE
				BuildHive.failStreak = 0
				BuildHive.status = "Paused: no hive change detected"
			else
				BuildHive.status = "Timeout; slot cooled down"
			end
		end
		return
	end

	if now - BuildHive.lastAttemptAt < BuildHive.SCAN_INTERVAL then return end
	BuildHive.lastAttemptAt = now

	BuildHive.status = "Scanning Hive"
	local cells = scanHive()
	if not cells then BuildHive.status = "Cannot read hive"; return end

	BuildHive.status = "Calculating Requirements"
	local state, priorityCounts, stage = computeAll(cells)

	local aligned, alignStatus = alignSettingForStage(stage)
	if not aligned then
		BuildHive.status = string.format("Aligning Until Legendary — %s (%.1fs)",
			alignStatus, now - StageControl.stageEnteredAt)
		return
	end

	BuildHive.status = "Finding Eligible Slot"
	local plan = planNextAction(cells)

	if plan.action == "done" then
		BuildHive.running = false
		BuildHive.status = "Build Complete"
		print("[BuildHive] DONE: all targets met")
		return
	elseif plan.action == "no_eligible" then
		BuildHive.running = false
		BuildHive.status = "No Eligible Slots"
		print("[BuildHive] STOP: " .. tostring(plan.reason or "no eligible"))
		return
	elseif plan.action == "wait" then
		BuildHive.status = "Waiting: " .. (plan.reason or "cooldowns")
		return
	end

	if (Inventory.get("RoyalJelly") or 0) < 1 then
		BuildHive.running = false
		BuildHive.status = "Out of Royal Jelly"
		print("[BuildHive] STOP: out of Royal Jelly")
		return
	end

	local actionMsg, targetLabel
	if plan.action == "reroll_excess" then
		targetLabel = plan.targetBee or plan.sourceBee
		actionMsg = string.format("Replacing: %s @ (%d,%d)", targetLabel, plan.slot.x, plan.slot.y)
	elseif plan.action == "reroll_priority_excess" then
		targetLabel = plan.sourceBee
		actionMsg = string.format("Replacing: excess %s @ (%d,%d)", targetLabel, plan.slot.x, plan.slot.y)
	elseif plan.action == "reroll_legendary" then
		targetLabel = plan.targetBee or plan.sourceBee
		actionMsg = string.format("Replacing: %s @ (%d,%d)", targetLabel, plan.slot.x, plan.slot.y)
	else
		targetLabel = plan.targetBee or "priority bee"
		actionMsg = string.format("Replacing: %s @ (%d,%d)", targetLabel, plan.slot.x, plan.slot.y)
	end
	BuildHive.status = actionMsg
	print("[BuildHive] " .. actionMsg .. " [stage="..stage..", action="..plan.action.."]")

	local ok, msg, dataComplete = placeJelly(plan.slot, "RoyalJelly")
	BuildHive.lastFireAt = now
	if not ok then
		BuildHive.failStreak = BuildHive.failStreak + 1
		BuildHive.slotCooldowns[plan.slotKey] = now + BuildHive.SLOT_COOLDOWN
		BuildHive.status = "Remote Failed: " .. tostring(msg)
		print("[BuildHive] fire FAILED: " .. tostring(msg))
		if BuildHive.failStreak >= BuildHive.FAIL_THRESHOLD then
			BuildHive.pauseUntil = now + BuildHive.FAIL_PAUSE; BuildHive.failStreak = 0
		end
		return
	end
	if dataComplete then
		BuildHive.lastConfirmedAt = now
		BuildHive.failStreak = 0
		print("[BuildHive] fire OK (data complete, no wait needed)")
		BuildHive.status = "Replacing: confirmed, continuing"
	else
		BuildHive.pendingSlot = plan.slot
		BuildHive.pendingStartedAt = now
		BuildHive.pendingTargetBee = plan.targetBee
		BuildHive.status = "Waiting for Server"
		print("[BuildHive] fire OK (awaiting hive verification)")
	end
end


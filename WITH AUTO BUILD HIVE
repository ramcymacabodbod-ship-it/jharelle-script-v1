			TextSize=10, TextXAlignment=Enum.TextXAlignment.Left}, row)
		compLabels[beeName] = cnt
	end

	local statusSec = makeSection(page, "BUILD STATUS", 0, 3)
	statusSec.AutomaticSize = Enum.AutomaticSize.Y
	new("UIPadding", {PaddingBottom=UDim.new(0,6)}, statusSec)
	local phaseLbl = new("TextLabel", {Size=UDim2.new(1,-16,0,14), Position=UDim2.fromOffset(8,22),
		BackgroundTransparency=1, Text="Phase: —", TextColor3=C.muted, Font=FONT_MED,
		TextSize=9, TextXAlignment=Enum.TextXAlignment.Left}, statusSec)

	SCAN_INTERVAL=0.28, PENDING_INITIAL_WAIT=0.5, PENDING_MAX_WAIT=3.0,
	FAIL_THRESHOLD=3, FAIL_PAUSE=30, SLOT_COOLDOWN=60,
}

local StageControl = {
	currentStage = nil,
	stageEnteredAt = 0,
	lastRetryAt = 0,
	RETRY_INTERVAL = 2,
	MAX_WAIT = 5,
}

-- JellySettings is forward-declared at §5. Uses it here safely now.
local function alignSettingForStage(stage)
	local desired = (stage == "building")
	local key = "RollToLegendary"
	local now = os.clock()

	if StageControl.currentStage ~= stage then
		StageControl.currentStage = stage
		StageControl.stageEnteredAt = now
		StageControl.lastRetryAt = 0
		print(string.format("[BuildHive] stage=%s (desired RollToLegendary=%s)",
			stage, tostring(desired)))
	end

	local pv = JellySettings.pendingVerify[key]
	if pv and (now - pv.startedAt) >= JellySettings.VERIFY_TIMEOUT + 1 then
		JellySettings.pendingVerify[key] = nil
		pv = nil
	end
	local confirmed = JellySettings.states[key]

	if confirmed == desired and not pv then return true, "aligned" end

	local waited = now - StageControl.stageEnteredAt
	if waited > StageControl.MAX_WAIT then
		print(string.format("[BuildHive] aligning gave up after %.1fs (confirmed=%s desired=%s)",
			waited, tostring(confirmed), tostring(desired)))
		return true, "giving up"
	end

	if pv then return false, "verifying" end
	if StageControl.lastRetryAt > 0 and (now - StageControl.lastRetryAt) < StageControl.RETRY_INTERVAL then
		return false, "retry cooldown"
	end

	local ok, msg = JellySettings.setValue(key, desired)
	if ok then
		StageControl.lastRetryAt = now
		print(string.format("[BuildHive] sent RollToLegendary=%s (stage=%s waited %.1fs)",
			tostring(desired), stage, waited))
		return false, "sent"
	end
	if msg == "cooldown" then return false, "send cooldown" end
	StageControl.lastRetryAt = now
	print("[BuildHive] setValue error: " .. tostring(msg))
	return false, "error"
end

local function getBeeRarity(beeName)
	if not BeeTypes or not beeName then return nil end

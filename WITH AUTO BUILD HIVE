	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = input.Position; startPos = root.Position
		end
	end)
	titleBar.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false; requestSave()
		end
	end)
	State.connections[#State.connections+1] = UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			local nx, ny = clampWindowPosition(startPos.X.Offset + delta.X, startPos.Y.Offset + delta.Y)
			root.Position = UDim2.fromOffset(nx, ny)
		end
	end)
end
local minimized = false; local restoreSize = CONFIG.WINDOW_SIZE
minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		restoreSize = root.Size
		TweenService:Create(root, TweenInfo.new(0.18), {Size=UDim2.fromOffset(restoreSize.X.Offset, CONFIG.TITLE_HEIGHT)}):Play()
		body.Visible = false; statusBar.Visible = false
	else
		TweenService:Create(root, TweenInfo.new(0.18), {Size=restoreSize}):Play()
		body.Visible = true; statusBar.Visible = true
	end
end)
local function shutdown()
	if not State.running then return end
	State.running = false
	if _G.__TEST_SIMULATOR_INSTANCE == INSTANCE_ID then _G.__TEST_SIMULATOR_INSTANCE = nil end
	if _G.__TEST_SIMULATOR_CLEANUP == shutdown then _G.__TEST_SIMULATOR_CLEANUP = nil end
	SaveSystem.save()
	for _, c in ipairs(State.connections) do pcall(function() c:Disconnect() end) end
	State.connections = {}
	if _G.__TEST_SIMULATOR_GUI then
		pcall(function() _G.__TEST_SIMULATOR_GUI:Destroy() end); _G.__TEST_SIMULATOR_GUI = nil
	end
end
_G.__TEST_SIMULATOR_CLEANUP = shutdown
closeBtn.MouseButton1Click:Connect(shutdown)
local function applyScale()
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280,720)
	local neededW = CONFIG.WINDOW_POSITION.X.Offset + CONFIG.WINDOW_SIZE.X.Offset
	local neededH = CONFIG.WINDOW_POSITION.Y.Offset + CONFIG.WINDOW_SIZE.Y.Offset
	uiScale.Scale = math.max(0.6, math.min(1, math.min(vp.X / neededW, vp.Y / neededH)))
end
applyScale()
if Workspace.CurrentCamera then
	State.connections[#State.connections+1] =
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
end


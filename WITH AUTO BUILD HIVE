local function buildGearRequirements()
	local page = makePage("GearRequirements")
	local panels = {}
	for i, gear in ipairs(GEARS) do
		local h = 26 + #gear.requirements * 16 + 30 + 6
		local sec = makeSection(page, gear.name, h, i)
		local header = sec:FindFirstChild("TextLabel")
		local badge = new("TextLabel", {Size=UDim2.fromOffset(70,14), Position=UDim2.new(1,-78,0,6),
			BackgroundTransparency=1, Text="MISSING", TextColor3=C.gold, Font=FONT_BOLD, TextSize=9,
			TextXAlignment=Enum.TextXAlignment.Right}, sec)
		local list = new("Frame", {Size=UDim2.new(1,-16,0,#gear.requirements*16),
			Position=UDim2.fromOffset(8,26), BackgroundTransparency=1}, sec)
		new("UIListLayout", {Padding=UDim.new(0,0)}, list)
		local labels = {}
		for j = 1, #gear.requirements do
			labels[j] = new("TextLabel", {Size=UDim2.new(1,0,0,16), BackgroundTransparency=1,
				Text="", TextColor3=C.text, Font=FONT, TextSize=10,
				TextXAlignment=Enum.TextXAlignment.Left}, list)
		end
		local abY = 26 + #gear.requirements * 16 + 2
		local rjLbl = new("TextLabel", {Size=UDim2.fromOffset(70,20), Position=UDim2.fromOffset(8,abY),
			BackgroundTransparency=1, Text="Royal Jelly:", TextColor3=C.text, Font=FONT, TextSize=10}, sec)
		local rjAmt = new("TextLabel", {Size=UDim2.fromOffset(80,20), Position=UDim2.fromOffset(82,abY),
			BackgroundTransparency=1, Text="0", TextColor3=C.green, Font=FONT_BOLD, TextSize=11}, sec)
		local rjBtn = makeButton(sec, "Auto Buy: OFF", UDim2.fromOffset(96,20), C.panelAlt)
		rjBtn.Position = UDim2.fromOffset(168, abY)
		rjBtn.MouseButton1Click:Connect(function()
			if Ownership.owns(gear) then return end
			State.autoBuyRJ[gear.id] = not State.autoBuyRJ[gear.id]
			rjBtn.Text = State.autoBuyRJ[gear.id] and "Auto Buy: ON" or "Auto Buy: OFF"
			rjBtn.BackgroundColor3 = State.autoBuyRJ[gear.id] and C.green or C.panelAlt
			requestSave()
		end)
		panels[gear.id] = {gear=gear, section=sec, header=header, badge=badge,
			labels=labels, rjLbl=rjLbl, rjAmt=rjAmt, rjBtn=rjBtn}
	end
	Pages.GearRequirements = {frame=page, update=function()
		local res = AutoBuy.compute()
		for id, panel in pairs(panels) do
			local g = res.perGear[id]
			for j, lbl in ipairs(panel.labels) do
				local r = panel.gear.requirements[j]
				local name = r[1] == HONEY and "Honey" or Recipe.display(r[1])
				if g.owned then
					lbl.Text = string.format("%s — %s ✓", name, formatExact(r[2])); lbl.TextColor3 = C.green
				else
					local avail = r[1] == HONEY and getCurrentHoney() or Inventory.get(r[1])
					if avail ~= nil then
						local miss = math.max(0, r[2] - avail)
						lbl.Text = string.format("%s: need %s, have %s, miss %s",
							name, formatExact(r[2]), formatExact(avail), formatExact(miss))
						lbl.TextColor3 = (miss == 0) and C.green or C.text
					else
						lbl.Text = string.format("%s: need %s (avail ?)", name, formatExact(r[2]))
						lbl.TextColor3 = C.muted
					end
				end
			end
			if g.owned then
				panel.section.BackgroundColor3 = Color3.fromRGB(24,56,40)
				panel.section.UIStroke.Color = C.green; panel.header.TextColor3 = C.green
				panel.badge.Text = "OWNED"; panel.badge.TextColor3 = C.green
				panel.rjLbl.Visible = false; panel.rjAmt.Visible = false; panel.rjBtn.Visible = false
			else
				panel.section.BackgroundColor3 = C.panel; panel.section.UIStroke.Color = C.stroke
				panel.header.TextColor3 = C.text
				panel.badge.Text = "MISSING"; panel.badge.TextColor3 = C.gold
				panel.rjLbl.Visible = true; panel.rjAmt.Visible = true; panel.rjBtn.Visible = true
				local m = AutoBuy.computeRJForGear(panel.gear)
				panel.rjAmt.Text = m > 0 and ("-"..formatExact(m)) or "0"
				panel.rjAmt.TextColor3 = m > 0 and C.red or C.green
				panel.rjBtn.Text = State.autoBuyRJ[panel.gear.id] and "Auto Buy: ON" or "Auto Buy: OFF"
				panel.rjBtn.BackgroundColor3 = State.autoBuyRJ[panel.gear.id] and C.green or C.panelAlt
			end
		end
	end}
end


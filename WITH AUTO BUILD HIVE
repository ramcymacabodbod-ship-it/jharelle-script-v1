local AutoBuy = {}
function AutoBuy.computeRJForGear(gear)
	local cur = Inventory.get("RoyalJelly") or 0; local total = 0
	for _, req in ipairs(gear.requirements) do
		local t, amount = req[1], req[2]
		if t == HONEY then
		elseif t == "RoyalJelly" then total = total + amount
		else
			local have = Inventory.get(t) or 0
			local short = math.max(0, amount - have)
			if short > 0 then total = total + rjCostFor(t, short) end
		end
	end
	return math.max(0, total - cur)
end
function AutoBuy.computeDiamondEggMissing()
	local dm = findGear("DiamondMask"); if not dm or Ownership.owns(dm) then return 0 end
	return math.max(0, 5 - (Inventory.get("Diamond") or 0))
end
function AutoBuy.computeTotalMissingGlitter()
	local anyActive = false; local totalReq = 0
	for _, gear in ipairs(GEARS) do
		if State.autoBuyRJ[gear.id] and not Ownership.owns(gear) then
			anyActive = true
			for _, req in ipairs(gear.requirements) do
				if req[1] == "Glitter" then totalReq = totalReq + req[2] end
			end
		end
	end
	if not anyActive then return 0 end
	return math.max(0, totalReq - (Inventory.get("Glitter") or 0))
end
function AutoBuy.computeMagicBeansToPurchase()
	local mg = AutoBuy.computeTotalMissingGlitter(); if mg <= 0 then return 0 end
	return math.max(0, mg - (Inventory.get("MagicBean") or 0))
end
function AutoBuy.compute()
	local perGear, gearStates = {}, {}
	for _, gear in ipairs(GEARS) do
		local owned = Ownership.owns(gear); gearStates[gear.id] = owned
		perGear[gear.id] = {gear=gear, owned=owned, rjMissing=owned and 0 or AutoBuy.computeRJForGear(gear)}
	end
	return {perGear=perGear, gearStates=gearStates, diamondMissing=AutoBuy.computeDiamondEggMissing()}
end


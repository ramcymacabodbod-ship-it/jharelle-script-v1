local function tryRequire(name, timeout)
	local ok, mod = pcall(function()
		local m = ReplicatedStorage:WaitForChild(name, timeout or 10)
		if not m then return nil end
		return require(m)
	end)
	if ok then return mod end
	warn("[Test Simulator] could not require "..name); return nil
end
local function tryRequirePath(pathStr, timeout)
	local parts = {}; for p in pathStr:gmatch("[^%.]+") do parts[#parts+1]=p end
	local ok, mod = pcall(function()
		local cur = ReplicatedStorage
		for _, p in ipairs(parts) do cur = cur:WaitForChild(p, timeout or 5); if not cur then return nil end end
		return require(cur)
	end)
	if ok then return mod end; return nil
end


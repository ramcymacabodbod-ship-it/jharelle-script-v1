	corner(nameLbl, 5)
	local qtyLbl = new("TextLabel", {Size=UDim2.fromOffset(60,22), Position=UDim2.fromOffset(194,26),
		BackgroundColor3=C.panelAlt, Text=tostring(State.recipeQty), TextColor3=C.text,
		Font=FONT_MED, TextSize=11, BorderSizePixel=0}, head)
	corner(qtyLbl, 5)
	local prev = makeButton(head, "◀", UDim2.fromOffset(26,22), C.panelAlt); prev.Position = UDim2.fromOffset(258,26)
	local next = makeButton(head, "▶", UDim2.fromOffset(26,22), C.panelAlt); next.Position = UDim2.fromOffset(288,26)
	local minus = makeButton(head, "–", UDim2.fromOffset(24,22), C.panelAlt); minus.Position = UDim2.fromOffset(318,26)
	local plus = makeButton(head, "+", UDim2.fromOffset(24,22), C.panelAlt); plus.Position = UDim2.fromOffset(346,26)
	local outSec = makeSection(page, "DIRECT INGREDIENTS", 0, 2)
	outSec.AutomaticSize = Enum.AutomaticSize.Y
	new("UIPadding", {PaddingBottom=UDim.new(0,6)}, outSec)
	local outList = new("Frame", {Size=UDim2.new(1,-16,0,0), Position=UDim2.fromOffset(8,24),
		BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.Y}, outSec)
	new("UIListLayout", {Padding=UDim.new(0,2)}, outList)
	local baseSec = makeSection(page, "BASE BREAKDOWN", 0, 3)
	baseSec.AutomaticSize = Enum.AutomaticSize.Y
	new("UIPadding", {PaddingBottom=UDim.new(0,6)}, baseSec)
	local baseList = new("Frame", {Size=UDim2.new(1,-16,0,0), Position=UDim2.fromOffset(8,24),
		BackgroundTransparency=1, AutomaticSize=Enum.AutomaticSize.Y}, baseSec)
	new("UIListLayout", {Padding=UDim.new(0,2)}, baseList)
	local function expandBase(internal, qty, out, depth)
		depth = depth or 0
		if qty <= 0 then return end
		if depth > 6 then out[internal] = (out[internal] or 0) + qty; return end
		local recipe = BlenderRecipes and BlenderRecipes.Get(internal)
		if not recipe then out[internal] = (out[internal] or 0) + qty; return end
		for _, ing in ipairs(recipe.Ingredients) do expandBase(ing.Type, ing.Amount * qty, out, depth + 1) end
	end
	local function rebuild()
		local internal = RECIPE_TYPES[State.recipeIndex]
		nameLbl.Text = Recipe.display(internal); qtyLbl.Text = tostring(State.recipeQty)
		for _, ch in ipairs(outList:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
		for _, ch in ipairs(baseList:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
		local recipe = BlenderRecipes and BlenderRecipes.Get(internal); if not recipe then return end
		for _, ing in ipairs(recipe.Ingredients) do
			local need = ing.Amount * State.recipeQty; local have = Inventory.get(ing.Type)
			local miss = have and math.max(0, need - have) or nil
			new("TextLabel", {Size=UDim2.new(1,0,0,14), BackgroundTransparency=1,
				Text=string.format("%s — need %s (have %s, miss %s)", Recipe.display(ing.Type),
					formatExact(need), have and formatExact(have) or "?", miss and formatExact(miss) or "?"),
				TextColor3=(miss and miss == 0) and C.green or C.text, Font=FONT, TextSize=10,
				TextXAlignment=Enum.TextXAlignment.Left}, outList)
		end
		local base = {}; expandBase(internal, State.recipeQty, base)
		local sorted = {}; for k in pairs(base) do sorted[#sorted+1] = k end; table.sort(sorted)
		for _, k in ipairs(sorted) do
			local need, have = base[k], Inventory.get(k)
			local miss = have and math.max(0, need - have) or nil
			new("TextLabel", {Size=UDim2.new(1,0,0,14), BackgroundTransparency=1,
				Text=string.format("%s — need %s (have %s, miss %s)", Recipe.display(k),
					formatExact(need), have and formatExact(have) or "?", miss and formatExact(miss) or "?"),
				TextColor3=(miss and miss == 0) and C.green or C.text, Font=FONT, TextSize=10,
				TextXAlignment=Enum.TextXAlignment.Left}, baseList)
		end
	end
	prev.MouseButton1Click:Connect(function() State.recipeIndex = ((State.recipeIndex - 2) % #RECIPE_TYPES) + 1; rebuild(); requestSave() end)
	next.MouseButton1Click:Connect(function() State.recipeIndex = (State.recipeIndex % #RECIPE_TYPES) + 1; rebuild(); requestSave() end)
	minus.MouseButton1Click:Connect(function() State.recipeQty = math.max(1, State.recipeQty - 1); rebuild(); requestSave() end)
	plus.MouseButton1Click:Connect(function() State.recipeQty = State.recipeQty + 1; rebuild(); requestSave() end)
	rebuild()
	Pages.RecipeCalc = {frame=page, update=function() rebuild() end}
end


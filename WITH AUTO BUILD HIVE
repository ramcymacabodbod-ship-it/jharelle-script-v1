-- 11.7 AUTO JELLY SETTINGS (JellySettings forward-declared at §5)
--=====================================================================
JellySettings = {
	keys = {"RollToLegendary","RollToMythic","RollToGifted"},
	labels = {RollToLegendary="Until Legendary", RollToMythic="Until Mythic", RollToGifted="Required Gifted"},
	states = {}, lastSentAt = {}, pendingVerify = {},
	SEND_COOLDOWN = 1, VERIFY_TIMEOUT = 4,
}
function JellySettings.readFromCache()
	if not Cache then return end
	local stats = Cache:Get(); if not stats then return end
	local settings = stats.Settings
	if type(settings) ~= "table" then
		for _, key in ipairs(JellySettings.keys) do
			if not JellySettings.pendingVerify[key] then JellySettings.states[key] = nil end
		end
		return
	end
	local now = os.clock()
	for _, key in ipairs(JellySettings.keys) do
		local raw = settings[key]
		local realValue
		if raw == true then realValue = true
		elseif raw == false or raw == nil then realValue = false end
		local pv = JellySettings.pendingVerify[key]
		if pv then
			if realValue == pv.value then
				JellySettings.states[key] = realValue
				JellySettings.pendingVerify[key] = nil
			elseif (now - pv.startedAt) >= JellySettings.VERIFY_TIMEOUT then
				JellySettings.states[key] = realValue
				JellySettings.pendingVerify[key] = nil
			end
		else
			JellySettings.states[key] = realValue
		end
	end
end
function JellySettings.setValue(key, value)
	if not Events then return false, "Events module not loaded" end
	if JellySettings.lastSentAt[key] and (os.clock() - JellySettings.lastSentAt[key]) < JellySettings.SEND_COOLDOWN then
		return false, "cooldown"
	end
	JellySettings.lastSentAt[key] = os.clock()
	JellySettings.pendingVerify[key] = {value=value, startedAt=os.clock()}
	local ok, err = pcall(function() Events.ClientCall("PlayerSettingsEvent", key, value) end)
	if not ok then
		JellySettings.pendingVerify[key] = nil
		return false, tostring(err)
	end
	return true, "sent"
end
function JellySettings.getDisplay(key)
	local pv = JellySettings.pendingVerify[key]
	if pv then return (pv.value and "ON" or "OFF"), pv.value, true end
	local v = JellySettings.states[key]
	if v == true then return "ON", true, false
	elseif v == false then return "OFF", false, false
	else return "Unknown", nil, false end
end


local function syncAllPagesToState()
	for _, p in pairs(Pages) do if p.update then pcall(p.update) end end
end
local function refreshAll()
	resolvePending()
	if Cache and Cache.Get then pcall(function() Cache:Update() end) end
	JellySettings.readFromCache()
	local page = Pages[State.currentPage]
	if page and page.update then
		local ok, err = pcall(page.update)
		if not ok then warn("[Test Simulator] refresh error: "..tostring(err)) end
	end
end

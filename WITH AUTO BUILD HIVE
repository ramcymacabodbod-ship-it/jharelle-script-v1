--=====================================================================
local SaveSystem = {}
local SAVE_VERSION = 1
local SAVE_FOLDER = "TestSimulator"
local fsWrite, fsRead, fsIsFile, fsMakeFolder, fsIsFolder
pcall(function() fsWrite = writefile end)
pcall(function() fsRead = readfile end)
pcall(function() fsIsFile = isfile end)
pcall(function() fsMakeFolder = makefolder end)
pcall(function() fsIsFolder = isfolder end)
function SaveSystem.isSupported() return type(fsWrite) == "function" and type(fsRead) == "function" end
function SaveSystem.getPath()
	local u = LocalPlayer.Name; if not u or u == "" then u = "UnknownUser" end
	return SAVE_FOLDER.."/"..u:gsub("[^%w_%-]","_")..".json"
end
local function ensureFolder()
	if fsIsFolder then local ok, r = pcall(fsIsFolder, SAVE_FOLDER); if ok and r then return true end end
	if fsMakeFolder then
		pcall(fsMakeFolder, SAVE_FOLDER)
		if fsIsFolder then local ok, r = pcall(fsIsFolder, SAVE_FOLDER); if ok and r then return true end end
	end
	return fsIsFile and true or false
end
local function validateAmount(v, allowed)
	if type(v) ~= "number" then return nil end
	for _, a in ipairs(allowed) do if a == v then return a end end
	return nil
end
function SaveSystem.load()
	if not SaveSystem.isSupported() then return nil end
	ensureFolder(); local path = SaveSystem.getPath()
	local okF, exists = pcall(fsIsFile or function() return false end, path)
	if not okF or not exists then return nil end
	local okR, content = pcall(fsRead, path)
	if not okR or type(content) ~= "string" or #content == 0 then return nil end
	local okD, data = pcall(function() return HttpService:JSONDecode(content) end)
	if not okD or type(data) ~= "table" or data.version ~= SAVE_VERSION then return nil end
	return data
end
function SaveSystem.save()
	if not SaveSystem.isSupported() then return false end
	ensureFolder()
	local data = {version=SAVE_VERSION, savedAt=os.time(),
		autoBuyRJ={DiamondMask=State.autoBuyRJ.DiamondMask==true, PetalBelt=State.autoBuyRJ.PetalBelt==true,
			CrimsonGuard=State.autoBuyRJ.CrimsonGuard==true, CobaltGuard=State.autoBuyRJ.CobaltGuard==true},
		autoBuyDiamondEgg=State.autoBuyDiamondEgg==true, autoMagicBean=State.autoMagicBean==true,
		autoFieldDice=State.autoFieldDice==true, autoSpeedUp=State.autoSpeedUp==true,
		selectedRJ=State.selectedRJ, selectedTicket=State.selectedTicket,
		recipeIndex=State.recipeIndex, recipeQty=State.recipeQty, blenderQty=State.blenderQty,
		windowPos={x=root and root.Position.X.Offset or 128, y=root and root.Position.Y.Offset or 139}}
	local okE, encoded = pcall(function() return HttpService:JSONEncode(data) end)
	if not okE or type(encoded) ~= "string" then return false end
	return pcall(fsWrite, SaveSystem.getPath(), encoded) == true
end
function SaveSystem.applyToState(data)
	if type(data) ~= "table" then return end
	if type(data.autoBuyRJ) == "table" then
		for id in pairs(State.autoBuyRJ) do
			if type(data.autoBuyRJ[id]) == "boolean" then State.autoBuyRJ[id] = data.autoBuyRJ[id] end
		end
	end
	if type(data.autoBuyDiamondEgg) == "boolean" then State.autoBuyDiamondEgg = data.autoBuyDiamondEgg end
	if type(data.autoMagicBean) == "boolean" then State.autoMagicBean = data.autoMagicBean end
	if type(data.autoFieldDice) == "boolean" then State.autoFieldDice = data.autoFieldDice end
	if type(data.autoSpeedUp) == "boolean" then State.autoSpeedUp = data.autoSpeedUp end
	local rj = validateAmount(data.selectedRJ, CONFIG.ROYAL_JELLY_AMOUNTS); if rj then State.selectedRJ = rj end
	local tk = validateAmount(data.selectedTicket, CONFIG.TICKET_AMOUNTS); if tk then State.selectedTicket = tk end
	if type(data.recipeIndex) == "number" and data.recipeIndex >= 1 and data.recipeIndex <= #RECIPE_TYPES then
		State.recipeIndex = data.recipeIndex
	end
	if type(data.recipeQty) == "number" and data.recipeQty >= 1 then State.recipeQty = data.recipeQty end
	if type(data.blenderQty) == "number" and data.blenderQty >= 1 then State.blenderQty = data.blenderQty end
end
function SaveSystem.applyWindowPos(data)
	if type(data) ~= "table" or type(data.windowPos) ~= "table" or not root then return end
	local x, y = tonumber(data.windowPos.x), tonumber(data.windowPos.y)
	if x and y and x == x and y == y then
		x, y = clampWindowPosition(x, y); root.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
	end
end
local saveDebounceToken = 0; local uiReady = false
local function requestSave()
	if not uiReady then return end
	saveDebounceToken = saveDebounceToken + 1; local token = saveDebounceToken
	task.delay(0.5, function() if token == saveDebounceToken then SaveSystem.save() end end)
end
local loadedCfg = nil
pcall(function() loadedCfg = SaveSystem.load() end)
if loadedCfg then pcall(function() SaveSystem.applyToState(loadedCfg) end) end

